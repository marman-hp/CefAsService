<div id="frameStatsPanel" class="shrink-0 border-t border-neutral-800 px-3 py-2">
    <div class="text-[10px] uppercase tracking-wide text-neutral-500 font-semibold mb-1">Frames</div>
    <div class="flex items-center flex-wrap gap-x-3 gap-y-0.5 text-[11px] tabular-nums text-neutral-400">
        <span class="flex items-center gap-1.5">
            <span class="w-2 h-0.5 rounded-full bg-sky-400 inline-block"></span>Recv
            <b id="frameStatsRecvValue" class="text-neutral-200 font-medium">0/s</b>
        </span>
        <span class="flex items-center gap-1.5">
            <span class="w-2 h-0.5 rounded-full bg-emerald-400 inline-block"></span>Render
            <b id="frameStatsRenderValue" class="text-neutral-200 font-medium">0 fps</b>
        </span>
    </div>
</div>
