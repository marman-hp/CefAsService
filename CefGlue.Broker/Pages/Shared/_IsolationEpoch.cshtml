<script>
    window.CefGlueIsolationEpoch = (function () {
        var STORAGE_KEY = 'cefglue_isolation_epoch';
        var RELOAD_SECONDS = 5;

        var pageEpoch = null;

        function readStored() {
            try { return localStorage.getItem(STORAGE_KEY); } catch (e) { return null; }
        }

        function store(epoch) {
            try { localStorage.setItem(STORAGE_KEY, epoch); } catch (e) {   }
        }

        function showNotice(mode) {
            var label = mode === 'session' ? 'per-session isolation (every tab has its own login)' : 'per-tenant isolation (tabs share one login)';

            var overlay = document.createElement('div');
            overlay.setAttribute('role', 'alertdialog');
            overlay.setAttribute('aria-modal', 'true');
            overlay.setAttribute('aria-labelledby', 'isolationNoticeTitle');
            overlay.style.cssText = 'position:fixed;inset:0;z-index:2147483647;display:flex;align-items:center;justify-content:center;' +
                'padding:16px;background:rgba(8,10,14,0.78);font:15px/1.5 system-ui,-apple-system,"Segoe UI",sans-serif;';

            var card = document.createElement('div');
            card.style.cssText = 'max-width:420px;width:100%;box-sizing:border-box;background:#1c2129;color:#e6e9ee;' +
                'border:1px solid #e0a53d;border-radius:12px;padding:22px 24px;box-shadow:0 12px 40px rgba(0,0,0,0.5);';

            var title = document.createElement('div');
            title.id = 'isolationNoticeTitle';
            title.style.cssText = 'font-size:17px;font-weight:600;color:#e0a53d;margin-bottom:8px;';
            title.textContent = 'The server switched isolation mode';

            var body = document.createElement('p');
            body.style.cssText = 'margin:0 0 16px;';
            body.textContent = 'It now uses ' + label + '. All your pages were closed and you have been signed out of every site.';

            var countdown = document.createElement('p');
            countdown.style.cssText = 'margin:0 0 16px;color:#8b96a3;font-size:14px;';

            var button = document.createElement('button');
            button.type = 'button';
            button.textContent = 'Reload now';
            button.style.cssText = 'padding:9px 16px;border:0;border-radius:6px;background:#e0975a;color:#1c1210;font-weight:600;font-size:15px;cursor:pointer;';
            button.addEventListener('click', function () { window.location.reload(); });

            card.appendChild(title);
            card.appendChild(body);
            card.appendChild(countdown);
            card.appendChild(button);
            overlay.appendChild(card);
            document.body.appendChild(overlay);
            button.focus();

            var remaining = RELOAD_SECONDS;
            var tick = function () {
                countdown.textContent = 'Reloading in ' + remaining + 's…';
                if (remaining-- <= 0) {
                    window.location.reload();
                    return;
                }
                setTimeout(tick, 1000);
            };
            tick();
        }

        return {
            check: function (isolation) {
                if (!isolation || !isolation.epoch) {
                    return Promise.resolve();
                }

                var known = pageEpoch || readStored();
                pageEpoch = isolation.epoch;
                store(isolation.epoch);

                if (!known || known === isolation.epoch) {
                    return Promise.resolve();
                }

                console.warn('[isolation] Mode changed (epoch ' + known + ' -> ' + isolation.epoch + ', now ' + isolation.mode + ') - notifying and reloading.');
                showNotice(isolation.mode);
                return new Promise(function () { });
            },
        };
    })();
</script>
