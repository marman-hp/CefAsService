    private void RefreshEncoderManifests(Dictionary<string, string> active, Dictionary<string, string> pending)
    {
        var workerPath = Paths.WorkerExePath;
        if (!string.Equals(workerPath, _encoderManifestsWorkerPath, StringComparison.OrdinalIgnoreCase) || _encoderManifests.Count == 0)
        {
            _encoderManifests = EncoderManifestStore.Load(workerPath);
            _encoderManifestsWorkerPath = workerPath;
        }

        foreach (var manifest in _encoderManifests.Where(m => m.HasTunableSettings))
        {
            foreach (var setting in manifest.Settings)
            {
                var envVar = manifest.EnvVarName(setting);
                if (_encoderValues.ContainsKey(envVar))
                {
                    continue;
                }

                _encoderValues[envVar] =
                    pending != null && pending.TryGetValue(envVar, out var p) && !string.IsNullOrEmpty(p) ? p
                    : active != null && active.TryGetValue(envVar, out var a) && !string.IsNullOrEmpty(a) ? a
                    : setting.Default ?? "";
            }
        }
    }

    private Dictionary<string, string> SelectedEncoderSettingsForSave()
    {
        if (SelectedEncoderManifest is not { HasTunableSettings: true } manifest)
        {
            return null;
        }

        return manifest.Settings
            .Select(manifest.EnvVarName)
            .ToDictionary(envVar => envVar, envVar => _encoderValues.TryGetValue(envVar, out var value) ? value : "");
    }

