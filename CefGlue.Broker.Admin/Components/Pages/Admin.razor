        return await WorkerSource.SaveSettingsAsync(_selectedEncoder, _selectedMode, encoderSettings, _selectedAudioBitrateKbps, _selectedWebRtcPacingBps, _selectedWebRtcIceServers,
            !_disableGpuSeeded ? "" : _selectedDisableGpu ? "1" : "0", _selectedTextureEnable ? "1" : "", _selectedDiskCacheSizeBytes, _selectedMediaCacheSizeBytes,
            _selectedSessionTimeoutSeconds, _selectedManifestTtlSeconds,
            string.IsNullOrWhiteSpace(_selectedDefaultUrl) ? "" : _selectedDefaultUrl, _selectedNewPageUseLastUrl ? "1" : "0");
    }

    private void AddIceServer()
    {
        var uri = _newIceServerUri?.Trim();
        if (string.IsNullOrEmpty(uri))
        {
            return;
        }

        if (uri.StartsWith("turn:", StringComparison.OrdinalIgnoreCase) || uri.StartsWith("turns:", StringComparison.OrdinalIgnoreCase))
        {
            if (!string.IsNullOrEmpty(_newIceServerUsername) || !string.IsNullOrEmpty(_newIceServerPassword))
            {
                var schemeEnd = uri.IndexOf(':') + 1;
                uri = uri[..schemeEnd] + Uri.EscapeDataString(_newIceServerUsername ?? "") + ":" + Uri.EscapeDataString(_newIceServerPassword ?? "") + "@" + uri[schemeEnd..];
            }
        }

        _iceServerEntries.Add(uri);
        _selectedWebRtcIceServers = string.Join(",", _iceServerEntries);
        _newIceServerUri = "";
        _newIceServerUsername = "";
        _newIceServerPassword = "";
    }

    private void RemoveSelectedIceServer()
    {
        if (_selectedIceServerEntry == null)
        {
            return;
        }

        _iceServerEntries.Remove(_selectedIceServerEntry);
        _selectedWebRtcIceServers = string.Join(",", _iceServerEntries);
        _selectedIceServerEntry = null;
    }

    private void ResetIceServersToDefault()
    {
        _iceServerEntries = new List<string>();
        _selectedWebRtcIceServers = "";
        _selectedIceServerEntry = null;
    }

    private async Task StartWithCurrentSettings()
    {
        if (SessionTimingError != null)
        {
            return;
        }

        _starting = true;
        StateHasChanged();
        try
        {
            var persisted = await PersistCurrentSettingsAsync();
            await Supervisor.StopAsync();
            await Supervisor.StartAsync();

            if (!persisted)
            {
                var deadline = DateTime.UtcNow + TimeSpan.FromSeconds(30);
                while (DateTime.UtcNow < deadline && Supervisor.IsRunning)
                {
                    if (await PersistCurrentSettingsAsync())
                    {
                        await Supervisor.RestartAsync();
                        break;
                    }

                    await Task.Delay(TimeSpan.FromMilliseconds(500));
                }
            }
        }
        finally
        {
            _starting = false;
        }
    }

    private async Task ConfirmStop()
    {
        _confirmingStop = false;
        await Supervisor.StopAsync();
    }

