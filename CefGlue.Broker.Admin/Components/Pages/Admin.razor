    private void CheckRecordingLog()
    {
        _recordingLogProblems = null;
        var cefrec = CefRec();
        if (cefrec == null || !cefrec.IsUsable)
        {
            _recordingLogCheckMessage = "Can't check: " + (cefrec?.Error ?? "set the worker path in the Executables tab");
            return;
        }
        var json = cefrec.VerifyLog(AdminDb.Path, out var error);
        if (json == null)
        {
            _recordingLogCheckMessage = error;
            return;
        }
        using var doc = System.Text.Json.JsonDocument.Parse(json);
        var r = doc.RootElement;
        int N(string name) => r.TryGetProperty(name, out var v) && v.TryGetInt32(out var x) ? x : 0;
        var ok = r.TryGetProperty("ok", out var okEl) && okEl.ValueKind == System.Text.Json.JsonValueKind.True;
        var first = r.TryGetProperty("firstStartedUtc", out var f) ? f.GetString() : null;
        var older = r.TryGetProperty("olderRowsRemoved", out var o) && o.ValueKind == System.Text.Json.JsonValueKind.True;
        _recordingLogCheckMessage = (ok ? "Log intact" : "LOG WAS CHANGED OUTSIDE CAS") +
            $" - {N("rows")} rows ({N("chained")} signed, {N("erased")} erased, {N("legacy")} from before signing)" +
            (first != null ? $", starts {first}" : "") +
            (older ? " (older rows removed by the retention)" : "");
        if (!ok && r.TryGetProperty("problems", out var problems))
        {
            _recordingLogProblems = problems.EnumerateArray()
                .Select(p => (p.TryGetProperty("id", out var i) && i.GetString() is { Length: > 0 } pid ? pid + ": " : "") + p.GetProperty("problem").GetString())
                .ToList();
        }
    }

