@page "/admin"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject BrokerSupervisor Supervisor
@inject RemoteWorkerSource WorkerSource
@inject AdminAuth Auth
@inject AdminSettingsStore AdminSettings
@inject ExePaths Paths
@inject NavigationManager Navigation

<PageTitle>CefGlue Broker - Admin</PageTitle>

<div class="admin-page">
    <div class="page-header">
        <h1>CefGlue Broker Admin</h1>
        <form method="post" action="/logout">
            <AntiforgeryToken />
            <button class="btn" type="submit">Log out</button>
        </form>
    </div>

    @if (_isolationSwitch is { } isolationSwitch && isolationSwitch.AtUtc != _dismissedIsolationSwitchAtUtc)
    {
        <div class="warning-banner @(isolationSwitch.WipeOk ? "" : "warning-banner-error")" role="alert">
            <div>
                <strong>Isolation mode changed: per @isolationSwitch.From → per @isolationSwitch.To</strong>
                (broker start at @isolationSwitch.AtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")).
                @if (isolationSwitch.WipeOk)
                {
                    <span>The worker cache for every tenant was deleted - logins, cookies and site data are gone. Open tabs come back on their last URL, signed out.</span>
                }
                else
                {
                    <span>The worker cache could NOT be fully deleted (files still in use). Stop every worker, then restart the broker to retry.</span>
                }
            </div>
            <button class="btn" @onclick="() => _dismissedIsolationSwitchAtUtc = isolationSwitch.AtUtc">Dismiss</button>
        </div>
    }

    @if (WebRtcMissingEncoder is { } missingEncoder)
    {
        <div class="warning-banner" role="alert">
            <div>
                <strong>WebRTC needs a video encoder.</strong>
                Viewers get no video until @missingEncoder.DisplayName is installed.
                <div class="banner-attribution">@missingEncoder.Download.Attribution</div>
                @if (!string.IsNullOrEmpty(_bannerMessage))
                {
                    <div class="banner-error">@_bannerMessage</div>
                }
            </div>
            <button class="btn" disabled="@_bannerBusy" @onclick="() => DownloadFromBannerAsync(missingEncoder)">
                @(_bannerBusy ? "Downloading..." : $"Download from {missingEncoder.Download.Provider}")
            </button>
        </div>
    }
    else if (_justInstalledEncoder != null)
    {
        <div class="info-banner" role="status">
            <div>
                <strong>@_justInstalledEncoder installed.</strong>
                @(Supervisor.IsRunning ? "Restart the broker to start using it." : "Press Start to use it.")
            </div>
            @if (Supervisor.IsRunning)
            {
                <button class="btn" disabled="@_restarting" @onclick="RestartAfterInstallAsync">@(_restarting ? "Restarting..." : "Restart now")</button>
            }
            else
            {
                <button class="btn" @onclick="() => _justInstalledEncoder = null">Dismiss</button>
            }
        </div>
    }

    <section class="panel">
        <h2>Broker Controls</h2>

        <div class="control-row">
            <span>Status: <strong>@StatusText</strong></span>
            <span>PID: <strong>@(Supervisor.IsRunning ? Supervisor.Pid.ToString() : "-")</strong></span>
            <span>Uptime: <strong>@UptimeText</strong></span>
        </div>

        <div class="settings-tabs" role="tablist">
            @for (var i = 0; i < SettingsTabNames.Length; i++)
            {
                var tab = i;
                <button type="button" role="tab" aria-selected="@(_settingsTab == tab ? "true" : "false")"
                        class="settings-tab @(_settingsTab == tab ? "active" : "")" @onclick="() => _settingsTab = tab">
                    @SettingsTabNames[tab]
                    @if (SettingsTabHasPending(tab))
                    {
                        <span class="settings-tab-dot" title="Changed - restart to apply"></span>
                    }
                </button>
            }
        </div>

        <div class="settings-tab-page" hidden="@(_settingsTab != 0)">
        <div class="encoder-settings">
            <div class="encoder-header">
                <div class="encoder-heading">
                    <div class="encoder-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M4 5h16v10H4z M2 19h20 M9 15v4 M15 15v4"
                                  fill="none" stroke="currentColor"
                                  stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </div>

                    <div>
                        <div class="encoder-title">CEF Settings</div>
                        <div class="encoder-subtitle">
                            <span>GPU rendering, cache limits - applies at Chromium/CEF startup</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="encoder-body" style="flex-direction: column; gap: 0;">
                <div class="encoder-audio-row" style="margin-top: 0; padding-top: 0; border-top: none;">
                    <label class="checkbox-option">
                        <input type="checkbox" checked="@_selectedDisableGpu"
                               @onchange="@(e => _selectedDisableGpu = (bool)e.Value)" />
                        Disable GPU
                    </label>
                </div>

                <div class="encoder-audio-row">
                    <label class="checkbox-option" title="@(_selectedDisableGpu ? "Shared-texture rendering needs the GPU Disable GPU would be turning off" : null)">
                        <input type="checkbox" checked="@_selectedTextureEnable" disabled="@_selectedDisableGpu"
                               @onchange="@(e => _selectedTextureEnable = (bool)e.Value)" />
                        Texture Enable
                    </label>
                </div>

                <div class="encoder-audio-row">
                    <label for="disk-cache-size-input">Disk Cache Size</label>
                    <input id="disk-cache-size-input" type="number" min="0" step="1"
                           value="@SelectedDiskCacheSizeMb"
                           @onchange="@(e => SelectedDiskCacheSizeMb = (string)e.Value)" />
                    <span>MB</span>
                </div>

                <div class="encoder-audio-row">
                    <label for="media-cache-size-input">Media Cache Size</label>
                    <input id="media-cache-size-input" type="number" min="0" step="1"
                           value="@SelectedMediaCacheSizeMb"
                           @onchange="@(e => SelectedMediaCacheSizeMb = (string)e.Value)" />
                    <span>MB</span>
                </div>

                <div class="encoder-audio-row">
                    <label for="default-url-input">Default URL address</label>
                    <input id="default-url-input" type="text" spellcheck="false" class="url-input"
                           placeholder="@DefaultUrlFallback"
                           value="@_selectedDefaultUrl"
                           @onchange="@(e => _selectedDefaultUrl = ((string)e.Value)?.Trim())" />
                </div>

                <div class="encoder-audio-row">
                    <label class="checkbox-option">
                        <input type="checkbox" checked="@_selectedNewPageUseLastUrl"
                               @onchange="@(e => _selectedNewPageUseLastUrl = (bool)e.Value)" />
                        Use last URL when adding a new page
                    </label>
                    <span>@(_selectedNewPageUseLastUrl ? "\"+\" opens the address bar's current URL" : "\"+\" always opens the Default URL")</span>
                </div>

                <div class="encoder-audio-row worker-cache-row">
                    <label>Worker Cache</label>
                    <span>@FormatBytes(_cacheSizeBytes) @(_cacheTenantCount > 0 ? $"across {_cacheTenantCount} tenant(s)" : "")</span>

                    @if (_confirmingClearCache)
                    {
                        <span>Clear it? Requires no workers currently running.</span>
                        <button class="btn btn-danger" @onclick="ClearCacheAsync" disabled="@_clearingCache">Yes, clear</button>
                        <button class="btn" @onclick="() => _confirmingClearCache = false" disabled="@_clearingCache">Cancel</button>
                    }
                    else
                    {
                        <button class="btn btn-danger" @onclick="() => _confirmingClearCache = true" disabled="@(_clearingCache || !HasAnyCacheToClear)">
                            @(_clearingCache ? "Clearing..." : "Clear Cache")
                        </button>
                    }

                    @if (_clearCacheError != null)
                    {
                        <span class="pending-note">@_clearCacheError</span>
                    }
                </div>

                <div class="encoder-audio-row">
                    <label class="checkbox-option">
                        <input type="checkbox" checked="@_clearEverything" @onchange="@(e => _clearEverything = (bool)e.Value)" />
                        Clear everything
                    </label>
                    <span>also wipes the stale standalone dev-run cache - @FormatBytes(_standaloneCacheSizeBytes)</span>
                </div>
            </div>
        </div>
        </div>

        <div class="settings-tab-page" hidden="@(_settingsTab != 1)">
        <div class="encoder-settings">
            <div class="encoder-header">
                <div class="encoder-heading">
                    <div class="encoder-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M4 7h16M4 12h16M4 17h16M8 4v6M16 9v6M8 14v6"
                                  fill="none" stroke="currentColor"
                                  stroke-width="1.7" stroke-linecap="round" />
                        </svg>
                    </div>

                    <div>
                        <div class="encoder-title">Encoder Settings</div>
                        <div class="encoder-subtitle">
                            <select id="encoder-select" @bind="_selectedEncoder">
                                @foreach (var option in VisibleEncoderOptions)
                                {
                                    <option value="@(option.Value ?? "")">@option.Label</option>
                                }
                            </select>
                            @if (ActiveEncoderLibraryInfo != null)
                            {
                                <span>@ActiveEncoderLibraryInfo</span>
                            }
                        </div>
                    </div>
                </div>

                @if (HasTunableEncoderSettings)
                {
                    <div class="encoder-header-actions">
                        <button type="button"
                                class="reset-button"
                                title="Reset all tunable settings to defaults"
                                @onclick="ResetActiveEncoderSettings">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M3 11a9 9 0 1 1 2.64 6.36L3 14.72M3 5v6h6"
                                      fill="none"
                                      stroke="currentColor"
                                      stroke-width="1.8"
                                      stroke-linecap="round"
                                      stroke-linejoin="round" />
                            </svg>
                            <span>Reset</span>
                        </button>

                        <span class="encoder-badge">
                            <span class="status-dot"></span>
                            Tunable
                        </span>
                    </div>
                }
            </div>

            @if (SelectedEncoderManifest is { Download: not null } downloadManifest)
            {
                <EncoderDownloadPanel Manifest="downloadManifest" OnChanged="StateHasChanged" />
            }

            <div class="encoder-body">
                @if (_encoderManifests.Count == 0)
                {
                    <div class="encoder-empty-state">No encoder plugins found next to the worker exe (plugins\encoders). Check the worker path in the Executables tab.</div>
                }
                else if (string.IsNullOrEmpty(_selectedEncoder))
                {
                    <div class="encoder-empty-state">Select an encoder above to configure it. Left unset, the broker falls back to plain JPG frames, which needs no native encoder at all.</div>
                }
                else if (SelectedEncoderManifest is not { } manifest)
                {
                    <div class="encoder-empty-state">This encoder isn't installed in the configured worker build (no matching plugin.json).</div>
                }
                else if (manifest.HasTunableSettings || manifest.Fixed.Count > 0)
                {
                    <EncoderSettingsForm Manifest="manifest" Values="_encoderValues" OnChanged="OnEncoderSettingsChanged" />
                }
                else
                {
                    <div class="encoder-empty-state">This encoder has no additional tunable settings yet - it runs with its own built-in defaults.</div>
                }
            </div>

            <div class="encoder-audio-row">
                <label for="audio-bitrate-input">Audio Bitrate (Opus)</label>
                <input id="audio-bitrate-input" type="number" min="6" max="510" step="1"
                       value="@_selectedAudioBitrateKbps"
                       @onchange="@(e => _selectedAudioBitrateKbps = (string)e.Value)" />
                <span>kbps</span>
            </div>
        </div>
        </div>

        <div class="settings-tab-page" hidden="@(_settingsTab != 2)">
        <div class="encoder-settings">
            <div class="encoder-header">
                <div class="encoder-heading">
                    <div class="encoder-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M4 7l4-4M4 7l4 4M4 7h16M20 17l-4 4M20 17l-4-4M20 17H4"
                                  fill="none" stroke="currentColor"
                                  stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </div>

                    <div>
                        <div class="encoder-title">Transport</div>
                        <div class="encoder-subtitle">
                            <span>@(_activeUseWebRtc ? "WebRTC" : "WebSocket")</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="encoder-body" style="flex-direction: column;">
                <div class="encoder-empty-state" style="text-align: left;">
                    Fixed at broker launch via --use-webrtc - not changeable from Admin. Restart with a different flag to switch.
                </div>

                <div class="encoder-audio-row" style="margin-top: 0; padding-top: 0; border-top: none;">
                    <label>Connection Mode</label>
                    <div class="radio-group">
                        @foreach (var option in ConnectionModeOptions)
                        {
                            <label class="radio-option">
                                <input type="radio" name="mode-select" value="@option.Value"
                                       checked="@(_selectedMode == option.Value)"
                                       @onchange="() => _selectedMode = option.Value" />
                                @option.Label
                            </label>
                        }
                    </div>
                </div>

                @if (_activeUseWebRtc)
                {
                    <div class="encoder-audio-row">
                        <label for="webrtc-pacing-input">WebRTC Video Pacing</label>
                        <input id="webrtc-pacing-input" type="number" min="1000000" step="1000000"
                               value="@_selectedWebRtcPacingBps"
                               @onchange="@(e => _selectedWebRtcPacingBps = (string)e.Value)" />
                        <span>bps</span>
                        <button type="button" class="btn" @onclick="@(() => _selectedWebRtcPacingBps = "500000000")">Use 500M</button>
                    </div>

                    <div class="encoder-audio-row">
                        <label>WebRTC ICE Servers</label>
                        <select size="4" style="min-width:420px;" @bind="_selectedIceServerEntry">
                            @foreach (var uri in _iceServerEntries)
                            {
                                <option value="@uri">@uri</option>
                            }
                        </select>
                    </div>

                    <div class="encoder-audio-row">
                        <label for="ice-server-uri-input">STUN or TURN URI:</label>
                        <input id="ice-server-uri-input" type="text" style="min-width:280px;"
                               placeholder="stun:host:3478 or turn:host:3478?transport=udp"
                               @bind="_newIceServerUri" />
                    </div>

                    <div class="encoder-audio-row">
                        <label for="ice-server-username-input">TURN username:</label>
                        <input id="ice-server-username-input" type="text" @bind="_newIceServerUsername" />
                    </div>

                    <div class="encoder-audio-row">
                        <label for="ice-server-password-input">TURN password:</label>
                        <input id="ice-server-password-input" type="text" @bind="_newIceServerPassword" />
                    </div>

                    <div class="encoder-audio-row">
                        <button type="button" class="btn" @onclick="AddIceServer">Add Server</button>
                        <button type="button" class="btn btn-danger" @onclick="RemoveSelectedIceServer">Remove Server</button>
                        <button type="button" class="btn" @onclick="ResetIceServersToDefault">Reset to defaults</button>
                    </div>
                }
            </div>
        </div>
        </div>

        <div class="settings-tab-page" hidden="@(_settingsTab != 3)">
        <div class="encoder-settings">
            <div class="encoder-header">
                <div class="encoder-heading">
                    <div class="encoder-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 8v4l3 3M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z"
                                  fill="none" stroke="currentColor"
                                  stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </div>

                    <div>
                        <div class="encoder-title">Session &amp; Cleanup</div>
                        <div class="encoder-subtitle">
                            <span>Worker lifecycle</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="encoder-body" style="flex-direction: column;">
                <div class="encoder-audio-row" style="margin-top: 0; padding-top: 0; border-top: none;">
                    <label for="session-timeout-input">Session Timeout</label>
                    <input id="session-timeout-input" type="number" min="1" step="1"
                           aria-invalid="@(SessionTimingError != null ? "true" : "false")"
                           value="@_selectedSessionTimeoutSeconds"
                           @onchange="@(e => _selectedSessionTimeoutSeconds = (string)e.Value)" />
                    <span>sec (how long a worker runs with no viewer before it stops - tabs and logins are kept, see Manifest TTL)</span>
                </div>

                <div class="encoder-audio-row">
                    <label for="manifest-ttl-input">Manifest TTL</label>
                    <input id="manifest-ttl-input" type="number" min="1" step="1"
                           aria-invalid="@(SessionTimingError != null ? "true" : "false")"
                           aria-describedby="session-timing-error"
                           value="@_selectedManifestTtlSeconds"
                           @onchange="@(e => _selectedManifestTtlSeconds = (string)e.Value)" />
                    <span>sec (how long a timed-out tenant's tabs and logins are kept before being deleted)</span>
                </div>
                @if (SessionTimingError is { } timingError)
                {
                    <div id="session-timing-error" class="error" role="alert">@timingError</div>
                }

                <div class="encoder-audio-row">
                    <label>Isolation Mode</label>
                    <strong>@IsolationModeLabel</strong>
                    <span>fixed at broker launch via --isolation-mode-session. Switching it wipes the worker cache (all logins) on the next broker start.</span>
                </div>
            </div>
        </div>
        </div>

        <div class="settings-tab-page" hidden="@(_settingsTab != 4)">
        <div class="encoder-settings">
            <div class="encoder-header">
                <div class="encoder-heading">
                    <div class="encoder-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M3 5h18v14H3z M3 9h18 M7 13l2 2-2 2 M12 17h4"
                                  fill="none" stroke="currentColor"
                                  stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </div>

                    <div>
                        <div class="encoder-title">Executables</div>
                        <div class="encoder-subtitle">
                            <span>Broker and worker exe paths - applies on the next Start/Restart</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="encoder-body" style="flex-direction: column;">
                <div class="path-form">
                    <label>Broker exe (@ExePaths.BrokerExeName)
                        <input type="text" spellcheck="false" @bind="_brokerPathInput"
                               placeholder="@PathPlaceholder("CEFGLUE_BROKER_EXE_PATH")" />
                        <span class="path-status">Running: @(Supervisor.IsRunning ? Supervisor.RunningExePath ?? "unknown (attached)" : "-")</span>
                    </label>
                    <label>Worker exe (@ExePaths.WorkerExeName)
                        <input type="text" spellcheck="false" @bind="_workerPathInput"
                               placeholder="@PathPlaceholder("CEFGLUE_WORKER_EXE_PATH")" />
                        <span class="path-status">In use by Broker: @(Supervisor.IsRunning ? _activeWorkerExePath ?? "unknown" : "-")</span>
                    </label>
                </div>
                <div class="control-row">
                    <button class="btn" @onclick="SavePaths">Save paths</button>
                    @if (_pathError != null)
                    {
                        <span class="error">@_pathError</span>
                    }
                    else if (_pathMessage != null)
                    {
                        <span class="pending-note">@_pathMessage</span>
                    }
                </div>
                @if (PathsNeedRestart)
                {
                    <div class="control-row">
                        <span class="pending-note">Saved paths differ from the running ones - restart the broker to use them.</span>
                    </div>
                }
            </div>
        </div>
        </div>

        <div class="settings-tab-page" hidden="@(_settingsTab != 5)">
        <div class="encoder-settings">
            <div class="encoder-header">
                <div class="encoder-heading">
                    <div class="encoder-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M6 11h12v9H6z M8.5 11V8a3.5 3.5 0 0 1 7 0v3"
                                  fill="none" stroke="currentColor"
                                  stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </div>

                    <div>
                        <div class="encoder-title">Admin Password</div>
                        <div class="encoder-subtitle">
                            <span>Changing it signs out every Admin session, this one included</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="encoder-body admin-password-body" style="flex-direction: column;">
                <div class="password-form">
                    <label>Current password
                        <input type="password" autocomplete="current-password" @bind="_currentPassword" />
                    </label>
                    <label>New password
                        <input type="password" autocomplete="new-password" @bind="_newPassword" />
                    </label>
                    <label>Confirm new password
                        <input type="password" autocomplete="new-password" @bind="_confirmPassword" />
                    </label>
                </div>
                <div class="control-row">
                    <button class="btn" @onclick="ChangePassword">Change password</button>
                    @if (_passwordError != null)
                    {
                        <span class="error">@_passwordError</span>
                    }
                </div>
            </div>
        </div>
        </div>

        @if (HasUnappliedSettings)
        {
            <div class="control-row">
                <span class="pending-note">One or more fields have changed - restart the broker to apply them.</span>
            </div>
        }

        <div class="control-row">
            @if (_starting || _restarting)
            {
                <button class="btn" disabled>@(_starting ? "Starting…" : "Restarting…")</button>
            }
            else if (!Supervisor.IsRunning)
            {
                <button class="btn" @onclick="StartWithCurrentSettings" disabled="@(Paths.BrokerStartBlocker != null || SessionTimingError != null)">Start</button>
                @if (Paths.BrokerStartBlocker is { } startBlocker)
                {
                    <span class="error">@startBlocker Set it in the Executables tab.</span>
                }
                else if (SessionTimingError != null)
                {
                    <span class="error">Fix Session Timeout / Manifest TTL in the Session &amp; Cleanup tab first.</span>
                }
            }
            else if (_confirmingStop)
            {
                <span>Stop the broker?</span>
                <button class="btn btn-danger" @onclick="ConfirmStop">Yes, stop</button>
                <button class="btn" @onclick="() => _confirmingStop = false">Cancel</button>
            }
            else if (_confirmingRestart)
            {
                <span>
                    Restart the broker? Already-registered workers survive this.
                    @if (HasUnappliedSettings)
                    {
                        <text> Also applies the CEF Settings/Default Encoder/Connection Mode/Audio Bitrate selections above.</text>
                    }
                </span>
                <button class="btn btn-danger" @onclick="ConfirmRestart" disabled="@(SessionTimingError != null)">Yes, restart</button>
                @if (SessionTimingError != null)
                {
                    <span class="error">Fix Session Timeout / Manifest TTL in the Session &amp; Cleanup tab first.</span>
                }
                <button class="btn" @onclick="() => _confirmingRestart = false">Cancel</button>
            }
            else
            {
                <button class="btn btn-danger" @onclick="() => _confirmingStop = true">Stop</button>
                <button class="btn btn-danger" @onclick="() => _confirmingRestart = true">Restart</button>
            }
        </div>
    </section>

    <section class="panel">
        <h2>Workers (@_workers.Count(w => w.Status != "Sleeping") running, @_workers.Count(w => w.Status == "Sleeping") sleeping)</h2>

        @if (_workers.Count == 0)
        {
            <p class="empty">No workers or sleeping sessions right now.</p>
        }
        else
        {
            <div class="table-scroll">
            <table>
                <thead>
                    <tr>
                        <th>Tenant</th>
                        <th>Status</th>
                        <th>Address</th>
                        <th>CPU</th>
                        <th>Sessions</th>
                        <th>OS</th>
                        <th>Client IP</th>
                        <th>Created</th>
                        <th>Last beat / asleep</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var worker in _workers)
                    {
                        <tr>
                            <td class="mono">@worker.TenantId</td>
                            <td><span class="pill @(worker.Status == "Healthy" ? "healthy" : worker.Status == "Sleeping" ? "sleeping" : "degraded")">@worker.Status</span></td>
                            <td class="mono">@(worker.Status == "Sleeping" ? "-" : worker.Address)</td>
                            <td class="mono">@(worker.Status == "Sleeping" ? "-" : worker.Cpu.ToString("F1") + "%")</td>
                            <td class="mono">@worker.Sessions</td>
                            <td>@(worker.ClientOs ?? "-")</td>
                            <td class="mono">@(worker.ClientIp ?? "-")</td>
                            <td class="mono" title="@(worker.CreatedUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss"))">@(worker.CreatedUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                            <td class="mono">@SecondsAgo(worker.LastHeartbeatUtc)</td>
                            <td>
                                @if (_confirmingKillTenantId == worker.TenantId)
                                {
                                    <span class="kill-note">Ends the session: tabs and logins are deleted.</span>
