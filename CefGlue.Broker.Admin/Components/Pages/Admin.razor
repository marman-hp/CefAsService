    private static long TotalMemoryBytes => GC.GetGCMemoryInfo().TotalAvailableMemoryBytes;

    private static long SumCasWorkingSet()
    {
        long total = 0;
        foreach (var name in new[] { "Xilium.CefGlue.Headless.Service", "Xilium.CefGlue.BrowserProcess" })
        {
            foreach (var process in System.Diagnostics.Process.GetProcessesByName(name))
            {
                try { total += process.WorkingSet64; } catch { } finally { process.Dispose(); }
            }
        }

        return total;
    }

    private bool SettingsTabHasPending(int tab) => tab switch
    {
        0 => ShowPendingDisableGpuNote || ShowPendingTextureEnableNote || ShowPendingDiskCacheSizeBytesNote || ShowPendingMediaCacheSizeBytesNote
             || ShowPendingDefaultUrlNote || ShowPendingNewPageUseLastUrlNote,
        1 => ShowPendingEncoderNote || ShowPendingEncoderTuningNote || ShowPendingAudioBitrateNote,
        2 => ShowPendingModeNote || ShowPendingWebRtcPacingBpsNote || ShowPendingWebRtcIceServersNote || ShowPendingRequireTicketsNote,
        3 => ShowPendingSessionTimeoutNote || ShowPendingManifestTtlNote || SessionTimingError != null,
        4 => PathsNeedRestart || Paths.BrokerStartBlocker != null,
        7 => LimitsPending,
        9 => ProxyPending,
        _ => false,
    };

    private bool ProxyPending
    {
        get
        {
            if (!_proxySeeded)
            {
                return false;
            }

            static string CanonicalPool(string text)
                => Xilium.CefGlue.Headless.Service.ProxyUrl.TryParsePool(text, out var entries, out _)
                    ? string.Join("\n", entries.Select(e => e.Endpoint.ToUrl() + " # " + e.Label))
                    : (text ?? "").Trim();

            if (_selectedProxyEnabled != (_savedProxyEnabled == "1"))
            {
                return true;
            }

            var savedPool = string.Equals(_savedProxyMode, "pool", StringComparison.OrdinalIgnoreCase);
            if ((_selectedProxyMode == "pool") != savedPool)
            {
                return true;
            }

            return CanonicalPool(ComposedPool()) != CanonicalPool(_savedProxyPool)
                || GlobalIdNow() != (_savedProxyGlobalId ?? "");
        }
    }

    private bool HasUnappliedSettings => ShowPendingEncoderNote || ShowPendingEncoderTuningNote || ShowPendingModeNote || ShowPendingAudioBitrateNote || ShowPendingWebRtcPacingBpsNote || ShowPendingWebRtcIceServersNote
        || ShowPendingDisableGpuNote || ShowPendingTextureEnableNote || ShowPendingDiskCacheSizeBytesNote || ShowPendingMediaCacheSizeBytesNote
        || ShowPendingDefaultUrlNote || ShowPendingNewPageUseLastUrlNote
        || ShowPendingSessionTimeoutNote || ShowPendingManifestTtlNote || LimitsPending || ProxyPending || ShowPendingRequireTicketsNote;

    protected override void OnInitialized()
    {
        var saved = AdminSettings.Snapshot();
        _brokerPathInput = saved.BrokerExePath;
        _workerPathInput = saved.WorkerExePath;

        _encoderManifests = EncoderManifestStore.Load(Paths.WorkerExePath);
        _encoderManifestsWorkerPath = Paths.WorkerExePath;

        Supervisor.StatusChanged += OnSupervisorStatusChanged;
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        _refreshLoopTask = RefreshLoopAsync();
    }

    private void OnSupervisorStatusChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task RefreshLoopAsync()
    {
        try
        {
            await RefreshOnceAsync();

            while (await _timer.WaitForNextTickAsync(_cts.Token))
            {
                await RefreshOnceAsync();
            }
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
        }
    }

