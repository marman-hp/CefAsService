    private async Task RefreshOnceAsync()
    {
        var workers = await WorkerSource.GetWorkersAsync();
        var (cacheSizeBytes, cacheTenantCount, standaloneCacheSizeBytes) = await WorkerSource.GetCacheInfoAsync();

        BrokerDbView view = null;
        try
        {
            view = BrokerDbView.Read();
        }
        catch (Exception ex)
        {
            AdminDb.Fail(AdminDb.Error ?? $"Cannot read {AdminDb.Path}: {ex.Message}");
        }

        string Saved(string key) => view?.Saved.GetValueOrDefault(key);
        string Active(string key) => view == null ? null : view.BrokerRunning ? view.Active.GetValueOrDefault(key) : Saved(key);

        var (active, pending) = (Active("VideoEncoder"), Saved("VideoEncoder"));
        var (activeMode, pendingMode) = (Active("ConnectionMode"), Saved("ConnectionMode"));
        var (activeAudioBitrateKbps, pendingAudioBitrateKbps) = (Active("AudioBitrateKbps"), Saved("AudioBitrateKbps"));
        var (activeDisableGpu, pendingDisableGpu) = (Active("DisableGpu"), Saved("DisableGpu"));
        var (activeRequireTickets, pendingRequireTickets) = (Active("RequireTickets"), Saved("RequireTickets"));
        var (activeTextureEnable, pendingTextureEnable) = (Active("TextureEnable"), Saved("TextureEnable"));
        var (activeDiskCacheSizeBytes, pendingDiskCacheSizeBytes) = (Active("DiskCacheSizeBytes"), Saved("DiskCacheSizeBytes"));
        var (activeMediaCacheSizeBytes, pendingMediaCacheSizeBytes) = (Active("MediaCacheSizeBytes"), Saved("MediaCacheSizeBytes"));
        var (activeDefaultUrl, pendingDefaultUrl) = (Active("DefaultUrl"), Saved("DefaultUrl"));
        var (activeNewPageUseLastUrl, pendingNewPageUseLastUrl) = (Active("NewPageUseLastUrl"), Saved("NewPageUseLastUrl"));
        var activeUseWebRtc = view?.UseWebRtc;
        var (activeWebRtcPacingBps, pendingWebRtcPacingBps) = (Active("WebRtcPacingBps"), Saved("WebRtcPacingBps"));
        var (activeWebRtcIceServers, pendingWebRtcIceServers) = (Active("WebRtcIceServers"), Saved("WebRtcIceServers"));
        var (activeSessionTimeoutSeconds, pendingSessionTimeoutSeconds) = (Active("SessionTimeoutSeconds"), Saved("SessionTimeoutSeconds"));
        var (activeManifestTtlSeconds, pendingManifestTtlSeconds) = (Active("ManifestTtlSeconds"), Saved("ManifestTtlSeconds"));
        var pendingEncoderSettings = view?.SavedEncoderSettings;
        var activeEncoderSettings = view == null ? null : view.BrokerRunning ? view.ActiveEncoderSettings : view.SavedEncoderSettings;
        var availableEncoders = view?.AvailableEncoders ?? Array.Empty<string>();
        var activeWorkerExePath = view?.WorkerExePath;
        var (activeIsolationMode, isolationSwitch) = (view?.IsolationMode, view?.IsolationSwitch);

        await InvokeAsync(() =>
        {
            var hasRealData = view != null;
            if (hasRealData && !_seededFromBroker)
            {
                ClearSeededSelections();
                _seededFromBroker = true;
            }

            if (_reloadPhase == LoadingCurrentSettingsStep
                && ((view?.RuntimeUpdatedUtc is { } brokerReadyUtc && brokerReadyUtc >= _reloadLoadingSinceUtc)
                    || DateTime.UtcNow - _reloadLoadingSinceUtc > ReloadGuardTimeout))
            {
                _reloadPhase = null;
            }

            _workers = workers.OrderBy(w => w.TenantId).ToList();
            _activeEncoder = active;
            _pendingEncoder = pending;
            _availableEncoders = availableEncoders;
            _activeMode = activeMode;
            _pendingMode = pendingMode;
            _activeAudioBitrateKbps = activeAudioBitrateKbps;
            _pendingAudioBitrateKbps = pendingAudioBitrateKbps;
            _activeDisableGpu = activeDisableGpu;
            _activeRequireTickets = activeRequireTickets;
            _pendingDisableGpu = pendingDisableGpu;
            _activeTextureEnable = activeTextureEnable;
            _pendingTextureEnable = pendingTextureEnable;
            _activeDiskCacheSizeBytes = activeDiskCacheSizeBytes;
            _pendingDiskCacheSizeBytes = pendingDiskCacheSizeBytes;
            _activeMediaCacheSizeBytes = activeMediaCacheSizeBytes;
            _pendingMediaCacheSizeBytes = pendingMediaCacheSizeBytes;
            _activeDefaultUrl = activeDefaultUrl;
            _activeNewPageUseLastUrl = activeNewPageUseLastUrl;
            _selectedDefaultUrl ??= pendingDefaultUrl ?? activeDefaultUrl ?? DefaultUrlFallback;
            if (!_newPageUseLastUrlSeeded)
            {
                _selectedNewPageUseLastUrl = (pendingNewPageUseLastUrl ?? activeNewPageUseLastUrl ?? "1") != "0";
                _newPageUseLastUrlSeeded = true;
            }
            if (!_recordingEnabledSeeded)
            {
                _selectedRecordingEnabled = Saved("RecordingEnabled") == "1";
                _recordingEnabledSeeded = true;
            }
            if (!_devToolsEnabledSeeded)
            {
                _selectedDevToolsEnabled = Saved("DevToolsEnabled") == "1";
                _devToolsEnabledSeeded = true;
            }
            _selectedRecordingMaxConcurrent ??= Saved("RecordingMaxConcurrent") ?? "2";
            _recordingWarningAcceptedAt ??= Saved("RecordingWarningAcceptedAt");
            _selectedRecordingLogDays ??= Saved("RecordingLogDays") ?? Xilium.CefGlue.Broker.Storage.RecordingLog.DefaultDays.ToString();
            _selectedRecordingMaxMinutes ??= Saved("RecordingMaxMinutes") ?? "30";
            _selectedFilterMode ??= Saved("FilterMode") ?? "Internal";
            _selectedFilterEnforce ??= Saved("FilterEnforce") ?? "essential";
            _selectedFilterAllow ??= Saved("FilterAllowHosts") ?? "";
            _selectedFilterDeny ??= Saved("FilterDenyHosts") ?? "";
            _selectedDevToolsProfile ??= Saved("DevToolsProfile") ?? "restricted";
            if (!_proxySeeded)
            {
                SeedProxy(Saved("ProxyGlobal"), Saved("ProxyMode"), Saved("ProxyPool"), Saved("ProxyEnabled"), Saved("ProxyGlobalId"));
            }
            _savedProxyEnabled = Saved("ProxyEnabled");
            _savedProxyMode = Saved("ProxyMode");
            _savedProxyPool = Saved("ProxyPool");
            _savedProxyGlobal = Saved("ProxyGlobal");
            _savedProxyGlobalId = Saved("ProxyGlobalId");
            if (!_filterBlockFileSeeded)
            {
                _selectedFilterBlockFile = Saved("FilterBlockFileScheme") != "0";
                _filterBlockFileSeeded = true;
            }
            foreach (var limit in LimitFields)
            {
                _activeLimits[limit.Key] = Active(limit.Key);
                if (!_selectedLimits.ContainsKey(limit.Key))
                {
                    _selectedLimits[limit.Key] = Saved(limit.Key) ?? Active(limit.Key) ?? LimitDefault(limit.Key);
                }
            }
            if (_settingsTab == 7)
            {
                _casWorkingSetBytes = SumCasWorkingSet();
            }
            _activeUseWebRtc = string.Equals(activeUseWebRtc, "1", StringComparison.OrdinalIgnoreCase);
            _activeWebRtcPacingBps = activeWebRtcPacingBps;
            _pendingWebRtcPacingBps = pendingWebRtcPacingBps;
            _activeWebRtcIceServers = activeWebRtcIceServers;
            _pendingWebRtcIceServers = pendingWebRtcIceServers;
            _activeSessionTimeoutSeconds = activeSessionTimeoutSeconds;
            _pendingSessionTimeoutSeconds = pendingSessionTimeoutSeconds;
            _activeManifestTtlSeconds = activeManifestTtlSeconds;
            _pendingManifestTtlSeconds = pendingManifestTtlSeconds;
            _cacheSizeBytes = cacheSizeBytes;
            _cacheTenantCount = cacheTenantCount;
            _standaloneCacheSizeBytes = standaloneCacheSizeBytes;
            _activeWorkerExePath = activeWorkerExePath;
            _activeIsolationMode = activeIsolationMode;
            _isolationSwitch = isolationSwitch;

            _selectedEncoder ??= pending ?? active;
            _selectedMode ??= pendingMode ?? activeMode ?? "relay";
            _selectedAudioBitrateKbps ??= pendingAudioBitrateKbps ?? activeAudioBitrateKbps ?? "48";
            _selectedWebRtcPacingBps ??= pendingWebRtcPacingBps ?? activeWebRtcPacingBps ?? "500000000";
            _selectedWebRtcIceServers ??= pendingWebRtcIceServers ?? activeWebRtcIceServers ?? "";
            _selectedSessionTimeoutSeconds ??= pendingSessionTimeoutSeconds ?? activeSessionTimeoutSeconds ?? "300";
            _selectedManifestTtlSeconds ??= pendingManifestTtlSeconds ?? activeManifestTtlSeconds ?? "900";
            _selectedDiskCacheSizeBytes ??= pendingDiskCacheSizeBytes ?? activeDiskCacheSizeBytes ?? "30000000";
            _selectedMediaCacheSizeBytes ??= pendingMediaCacheSizeBytes ?? activeMediaCacheSizeBytes ?? "30000000";

            if (!_requireTicketsSeeded)
            {
                _selectedRequireTickets = (pendingRequireTickets ?? activeRequireTickets ?? "0") == "1";
                _requireTicketsSeeded = true;
            }

            if (!_disableGpuSeeded)
            {
                _selectedDisableGpu = (pendingDisableGpu ?? activeDisableGpu ?? "1") == "1";
                _disableGpuSeeded = true;
            }

            if (!_textureEnableSeeded)
            {
                _selectedTextureEnable = !string.IsNullOrEmpty(pendingTextureEnable ?? activeTextureEnable);
                _textureEnableSeeded = true;
            }

            if (!_iceServerEntriesSeeded)
            {
                _iceServerEntries = string.IsNullOrEmpty(_selectedWebRtcIceServers)
                    ? new List<string>()
                    : _selectedWebRtcIceServers.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
                _iceServerEntriesSeeded = true;
            }

            _activeEncoderSettings = activeEncoderSettings;
            RefreshEncoderManifests(activeEncoderSettings, pendingEncoderSettings);

            if (_seededFromBroker && _savedSnapshot == null)
            {
                _savedSnapshot = SaveSnapshot();
            }

            if (_initialLoadPending)
            {
                _initialLoadPending = false;
                if (_reloadPhase == LoadingCurrentSettingsStep && !_starting && !_restarting)
                {
                    _reloadPhase = null;
                }
            }

            StateHasChanged();
        });
    }

    private void OnEncoderSettingsChanged() => StateHasChanged();

    private long _cacheSizeBytes;
    private int _cacheTenantCount;
    private long _standaloneCacheSizeBytes;
    private bool _clearEverything;
    private bool _clearingCache;
    private string _clearCacheError;
    private bool _confirmingClearCache;

    private bool HasAnyCacheToClear => _cacheSizeBytes > 0 || (_clearEverything && _standaloneCacheSizeBytes > 0);

    private static string FormatBytes(long bytes)
    {
        if (bytes >= 1_073_741_824) return $"{bytes / 1_073_741_824.0:0.##} GB";
        if (bytes >= 1_048_576) return $"{bytes / 1_048_576.0:0.##} MB";
        if (bytes >= 1024) return $"{bytes / 1024.0:0.##} KB";
        return $"{bytes} B";
    }

    private async Task ClearCacheAsync()
    {
        _confirmingClearCache = false;
        _clearingCache = true;
        _clearCacheError = null;
        StateHasChanged();

        var (success, error, _) = await WorkerSource.ClearCacheAsync(_clearEverything);
        if (!success)
        {
            _clearCacheError = error;
        }

        _clearingCache = false;
        await RefreshOnceAsync();
    }

    private Task<bool> PersistCurrentSettingsAsync()
    {
        var snapshot = SaveSnapshot();
        var fields = new Dictionary<string, string>();
        void Field(string key, string value)
        {
            if (value != null)
            {
                fields[key] = value;
            }
        }

        Field("VideoEncoder", _selectedEncoder);
        Field("ConnectionMode", _selectedMode);
        Field("AudioBitrateKbps", _selectedAudioBitrateKbps);
        Field("WebRtcPacingBps", _selectedWebRtcPacingBps);
        Field("WebRtcIceServers", _selectedWebRtcIceServers);
        Field("DisableGpu", !_disableGpuSeeded ? "" : _selectedDisableGpu ? "1" : "0");
        Field("RequireTickets", !_requireTicketsSeeded ? null : _selectedRequireTickets ? "1" : "0");
        Field("TextureEnable", _selectedTextureEnable ? "1" : "");
        Field("DiskCacheSizeBytes", _selectedDiskCacheSizeBytes);
        Field("MediaCacheSizeBytes", _selectedMediaCacheSizeBytes);
        Field("SessionTimeoutSeconds", _selectedSessionTimeoutSeconds);
        Field("ManifestTtlSeconds", _selectedManifestTtlSeconds);
        Field("DefaultUrl", string.IsNullOrWhiteSpace(_selectedDefaultUrl) ? "" : _selectedDefaultUrl);
        Field("NewPageUseLastUrl", _selectedNewPageUseLastUrl ? "1" : "0");
        Field("RecordingEnabled", _selectedRecordingEnabled ? "1" : "0");
        Field("RecordingMaxConcurrent", _selectedRecordingMaxConcurrent?.Trim());
        Field("RecordingMaxMinutes", _selectedRecordingMaxMinutes?.Trim());
        Field("RecordingWarningAcceptedAt", _recordingWarningAcceptedAt);
        Field("RecordingLogDays", _selectedRecordingLogDays?.Trim());
        Field("DevToolsEnabled", _selectedDevToolsEnabled ? "1" : "0");
        foreach (var limit in LimitFields)
        {
            Field(limit.Key, _selectedLimits.GetValueOrDefault(limit.Key)?.Trim());
        }
        Field("FilterMode", _selectedFilterMode);
        Field("FilterEnforce", _selectedFilterEnforce);
        Field("FilterAllowHosts", _selectedFilterAllow?.Trim());
        Field("FilterDenyHosts", _selectedFilterDeny?.Trim());
        Field("FilterBlockFileScheme", _selectedFilterBlockFile ? "" : "0");
        Field("DevToolsProfile", _selectedDevToolsProfile);
        Field("ProxyEnabled", !_proxySeeded ? null : _selectedProxyEnabled ? "1" : "0");
        Field("ProxyGlobalId", !_proxySeeded ? null : GlobalIdNow());
        Field("ProxyGlobal", !_proxySeeded ? null : "");
        Field("ProxyMode", !_proxySeeded ? null : _selectedProxyMode == "pool" ? "pool" : "");
        Field("ProxyPool", !_proxySeeded ? null : ComposedPool());

        try
        {
            BrokerSettingsWriter.Save(AdminDb.Db, fields, SelectedEncoderSettingsForSave());
            _savedSnapshot = snapshot;
            _saveError = null;
            return Task.FromResult(true);
        }
        catch (Exception ex)
        {
            _saveError = $"Settings not saved: {ex.Message}";
            Console.WriteLine($"[Admin] {_saveError}");
            return Task.FromResult(false);
        }
    }

    private string _saveError;

    private void AddIceServer()
    {
        var uri = _newIceServerUri?.Trim();
        if (string.IsNullOrEmpty(uri))
        {
            return;
        }

        if (uri.StartsWith("turn:", StringComparison.OrdinalIgnoreCase) || uri.StartsWith("turns:", StringComparison.OrdinalIgnoreCase))
        {
            if (!string.IsNullOrEmpty(_newIceServerUsername) || !string.IsNullOrEmpty(_newIceServerPassword))
            {
                var schemeEnd = uri.IndexOf(':') + 1;
                uri = uri[..schemeEnd] + Uri.EscapeDataString(_newIceServerUsername ?? "") + ":" + Uri.EscapeDataString(_newIceServerPassword ?? "") + "@" + uri[schemeEnd..];
            }
        }

        _iceServerEntries.Add(uri);
        _selectedWebRtcIceServers = string.Join(",", _iceServerEntries);
        _newIceServerUri = "";
        _newIceServerUsername = "";
        _newIceServerPassword = "";
    }

    private void RemoveSelectedIceServer()
    {
        if (_selectedIceServerEntry == null)
        {
            return;
        }

        _iceServerEntries.Remove(_selectedIceServerEntry);
        _selectedWebRtcIceServers = string.Join(",", _iceServerEntries);
        _selectedIceServerEntry = null;
    }

    private void ResetIceServersToDefault()
    {
        _iceServerEntries = new List<string>();
        _selectedWebRtcIceServers = "";
        _selectedIceServerEntry = null;
    }

    private async Task StartWithCurrentSettings()
    {
        if (SessionTimingError != null)
        {
            return;
        }

        _starting = true;
        var started = false;
        try
        {
            if (HasChangesToSave)
            {
                SetReloadPhase("Saving settings…");
                if (!await PersistCurrentSettingsAsync())
                {
                    return;
                }
            }

            SetReloadPhase("Starting the broker…");
            await Supervisor.StopAsync();
            await Supervisor.StartAsync();
            started = true;
        }
        finally
        {
            _starting = false;
            SetReloadPhase(started ? LoadingCurrentSettingsStep : null);
        }
    }

    private async Task ConfirmStop()
    {
        _confirmingStop = false;
        await Supervisor.StopAsync();
    }

    private EncoderManifest WebRtcMissingEncoder
    {
        get
        {
            if (!_activeUseWebRtc && !Supervisor.LaunchesWithWebRtc)
            {
                return null;
            }

            var id = Norm(_selectedEncoder) ?? Norm(_activeEncoder) ?? "openh264";
            var manifest = _encoderManifests.FirstOrDefault(m => string.Equals(m.Id, id, StringComparison.OrdinalIgnoreCase));
            return manifest is { Download: not null, IsInstalled: false } ? manifest : null;
        }
    }

    private bool _bannerBusy;
    private string _bannerMessage;
    private string _justInstalledEncoder;

    private async Task DownloadFromBannerAsync(EncoderManifest manifest)
    {
        _bannerBusy = true;
        _bannerMessage = null;
        StateHasChanged();
        try
        {
            var (ok, message) = await EncoderDownloader.InstallAsync(manifest);
            if (ok)
            {
                _justInstalledEncoder = manifest.DisplayName;
                if (Norm(_selectedEncoder) == null) _selectedEncoder = manifest.Id;
            }
            else
            {
                _bannerMessage = message;
            }
        }
        finally
        {
            _bannerBusy = false;
        }
    }

    private async Task RestartAfterInstallAsync()
    {
        await ConfirmRestart();
        _justInstalledEncoder = null;
    }

    private async Task ConfirmRestart()
    {
        if (SessionTimingError != null)
        {
            return;
        }

        _confirmingRestart = false;
        _restarting = true;
        var restarted = false;
        try
        {
            if (HasChangesToSave)
            {
                SetReloadPhase("Saving settings…");
                if (!await PersistCurrentSettingsAsync())
                {
                    return;
                }
            }

            SetReloadPhase("Restarting the broker…");
            await Supervisor.RestartAsync();
            restarted = true;
        }
        finally
        {
            _restarting = false;
            SetReloadPhase(restarted ? LoadingCurrentSettingsStep : null);
        }
    }

    private async Task ConfirmKill(string tenantId)
    {
        _confirmingKillTenantId = null;

        var (success, error) = await WorkerSource.KillWorkerAsync(tenantId);
        _lastKillError = success ? null : error;
    }

    private static string SecondsAgo(DateTime utc)
    {
        var seconds = Math.Max(0, (int)(DateTime.UtcNow - utc).TotalSeconds);
        return seconds < 60 ? $"{seconds}s ago" : $"{seconds / 60}m {seconds % 60}s ago";
    }

    public async ValueTask DisposeAsync()
    {
        Supervisor.StatusChanged -= OnSupervisorStatusChanged;
        _cts.Cancel();

        if (_refreshLoopTask != null)
        {
            try
            {
                await _refreshLoopTask;
            }
            catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
            {
            }
        }

        _timer?.Dispose();
        _cts.Dispose();
    }
}
