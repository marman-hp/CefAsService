            foreach (var manifest in _encoderManifests)
            {
                if (_availableEncoders.Length == 0
                    || _availableEncoders.Contains(manifest.Id)
                    || !manifest.IsInstalled
                    || manifest.Id == _selectedEncoder
                    || manifest.Id == _activeEncoder
                    || manifest.Id == _pendingEncoder)
                {
                    listed.Add(manifest.Id);
                    yield return (manifest.Id, manifest.IsInstalled ? manifest.DisplayName : $"{manifest.DisplayName} (not downloaded)");
                }
            }

            foreach (var id in new[] { _selectedEncoder, _activeEncoder, _pendingEncoder })
            {
                if (!string.IsNullOrEmpty(id) && listed.Add(id))
                {
                    yield return (id, $"{id} (not installed)");
