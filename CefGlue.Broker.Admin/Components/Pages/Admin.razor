    private sealed record ProxyRow(string Label, string Address, int Sessions, int Failing);

    private List<ProxyRow> ProxyRows()
    {
        var rows = new List<ProxyRow>();
        if (_savedProxyEnabled != "1")
        {
            return rows;
        }

        if (string.Equals(_savedProxyMode, "pool", StringComparison.OrdinalIgnoreCase))
        {
            if (Xilium.CefGlue.Headless.Service.ProxyUrl.TryParsePool(_savedProxyPool, out var pool, out _))
            {
                foreach (var entry in pool)
                {
                    var on = _workers.Where(w => w.Proxy?.Id == entry.Id).ToList();
                    rows.Add(new ProxyRow(entry.Label, entry.Endpoint.Server, on.Count, on.Count(w => w.Proxy.Failing)));
                }
            }
        }
        else if (!string.IsNullOrWhiteSpace(_savedProxyGlobalId))
        {
            if (Xilium.CefGlue.Headless.Service.ProxyUrl.TryParsePool(_savedProxyPool, out var globalPool, out _)
                && globalPool.FirstOrDefault(p => p.Id == _savedProxyGlobalId) is { } chosen)
            {
                var on = _workers.Where(w => w.Proxy?.Id == chosen.Id).ToList();
                rows.Add(new ProxyRow(chosen.Label, chosen.Endpoint.Server, on.Count, on.Count(w => w.Proxy.Failing)));
            }
        }
        else if (!string.IsNullOrWhiteSpace(_savedProxyGlobal) && Xilium.CefGlue.Headless.Service.ProxyUrl.TryParse(_savedProxyGlobal, out var endpoint, out _))
        {
            var on = _workers.Where(w => w.Proxy?.Id == "global").ToList();
            rows.Add(new ProxyRow("Global proxy", endpoint.Server, on.Count, on.Count(w => w.Proxy.Failing)));
        }

        return rows;
    }

