    private string _poolImportError;

    private static bool RowBlank(PoolRow r)
        => string.IsNullOrWhiteSpace(r.Host) && string.IsNullOrWhiteSpace(r.Port) && string.IsNullOrEmpty(r.User) && string.IsNullOrEmpty(r.Password) && string.IsNullOrWhiteSpace(r.Label);

    private static string RowUrl(PoolRow r)
    {
        var login = string.IsNullOrEmpty(r.User) || r.Type == "socks5"
            ? ""
            : $"{Uri.EscapeDataString(r.User)}:{Uri.EscapeDataString(r.Password ?? "")}@";
        var host = (r.Host ?? "").Trim();
        return $"{r.Type}://{login}{(host.Contains(':') && !host.StartsWith('[') ? $"[{host}]" : host)}:{(r.Port ?? "").Trim()}";
    }

    private string ComposedPool() => string.Join("\n", _poolRows.Where(r => !RowBlank(r)).Select(r =>
        RowUrl(r) + (string.IsNullOrWhiteSpace(r.Label) ? "" : " # " + r.Label.Trim().Replace('\r', ' ').Replace('\n', ' '))));

    private static string RowError(PoolRow r)
    {
        if (RowBlank(r))
        {
            return null;
        }

        if (string.IsNullOrWhiteSpace(r.Host))
        {
            return "This proxy needs a host.";
        }

        return Xilium.CefGlue.Headless.Service.ProxyUrl.TryParse(RowUrl(r), out _, out var error) ? null : error;
    }

    private string PoolListError()
    {
        if (_poolRows.Any(r => RowError(r) != null))
        {
            return null;
        }

        return Xilium.CefGlue.Headless.Service.ProxyUrl.TryParsePool(ComposedPool(), out _, out var error) ? null : error;
    }

    private PoolRow _poolDraft = new();
    private PoolRow _poolSelected;
    private string _poolFormError;

    private static PoolRow CopyOf(PoolRow r) => new() { Type = r.Type, Host = r.Host, Port = r.Port, User = r.User, Password = r.Password, Label = r.Label };

    private void ResetPoolForm()
    {
        _poolDraft = new PoolRow();
        _poolSelected = null;
        _poolFormError = null;
    }

    private void SelectPoolRow(PoolRow row)
    {
        _poolSelected = row;
        _poolDraft = CopyOf(row);
        _poolFormError = null;
    }

    private void CancelPoolEdit() => ResetPoolForm();

    private void DeletePoolRow()
    {
        if (_poolSelected != null)
        {
            if (ReferenceEquals(_poolSelected, _poolGlobal))
            {
                _poolGlobal = null;
            }

            _poolRows.Remove(_poolSelected);
        }

        ResetPoolForm();
    }

    private void AddOrUpdatePoolRow()
    {
        if (RowBlank(_poolDraft))
        {
            _poolFormError = "Fill in the host and port of the proxy first.";
            return;
        }

        var error = RowError(_poolDraft);
        if (error == null)
        {
            var others = _poolRows.Where(r => !ReferenceEquals(r, _poolSelected)).Select(r => RowUrl(r)).Append(RowUrl(_poolDraft));
            if (!Xilium.CefGlue.Headless.Service.ProxyUrl.TryParsePool(string.Join("\n", others), out _, out var poolError))
            {
                error = "That host and port is already in the pool.";
                _ = poolError;
            }
        }

        if (error != null)
        {
            _poolFormError = error;
            return;
        }

        if (_poolSelected == null)
        {
            var added = CopyOf(_poolDraft);
            _poolRows.Add(added);
            _poolGlobal ??= added;
        }
        else
        {
            var index = _poolRows.IndexOf(_poolSelected);
            var wasGlobal = ReferenceEquals(_poolRows[index], _poolGlobal);
            _poolRows[index] = CopyOf(_poolDraft);
            if (wasGlobal)
            {
                _poolGlobal = _poolRows[index];
            }
        }

        ResetPoolForm();
    }

    private void OnProxyModeChanged(string mode) => _selectedProxyMode = mode;

    private void ImportPoolLines()
    {
        var lines = (_poolImportText ?? "").Replace("\r", "").Split('\n')
            .Select(l => l.Trim())
            .Where(l => l.Length > 0 && !l.StartsWith('#'))
            .Select(l => l.Contains("://", StringComparison.Ordinal) ? l : $"{_poolImportType}://{l}")
            .ToList();
        if (lines.Count == 0)
        {
            _poolImportError = "Paste at least one proxy.";
            return;
        }

        if (!Xilium.CefGlue.Headless.Service.ProxyUrl.TryParsePool(string.Join("\n", lines), out var entries, out var error))
        {
            _poolImportError = error;
            return;
        }

        _poolRows.RemoveAll(RowBlank);
        foreach (var entry in entries)
        {
            var imported = new PoolRow
            {
                Type = entry.Endpoint.Scheme,
                Host = entry.Endpoint.Host,
                Port = entry.Endpoint.Port.ToString(),
                User = entry.Endpoint.User ?? "",
                Password = entry.Endpoint.Password ?? "",
                Label = entry.Label.StartsWith("Proxy ", StringComparison.Ordinal) && int.TryParse(entry.Label[6..], out _) ? "" : entry.Label,
            };
            _poolRows.Add(imported);
            _poolGlobal ??= imported;
        }

        _poolImportText = "";
        _poolImportError = null;
        _showPoolImport = false;
    }

    private void SeedProxy(string saved, string savedMode, string savedPool, string savedEnabled, string savedGlobalId)
    {
        _proxySeeded = true;
        _selectedProxyEnabled = savedEnabled == "1";
        _selectedProxyMode = string.Equals(savedMode, "pool", StringComparison.OrdinalIgnoreCase) ? "pool" : "global";
        _poolRows.Clear();
        _poolGlobal = null;
        ResetPoolForm();
        if (Xilium.CefGlue.Headless.Service.ProxyUrl.TryParsePool(savedPool, out var savedEntries, out _))
        {
            for (var i = 0; i < savedEntries.Count; i++)
            {
                var e = savedEntries[i];
                _poolRows.Add(new PoolRow
                {
                    Type = e.Endpoint.Scheme,
                    Host = e.Endpoint.Host,
                    Port = e.Endpoint.Port.ToString(),
                    User = e.Endpoint.User ?? "",
                    Password = e.Endpoint.Password ?? "",
                    Label = e.Label == $"Proxy {i + 1}" ? "" : e.Label,
                });
                if (!string.IsNullOrWhiteSpace(savedGlobalId) && e.Id == savedGlobalId)
                {
                    _poolGlobal = _poolRows[i];
                }
            }
        }

        if (_poolRows.Count == 0 && !string.IsNullOrWhiteSpace(saved)
            && Xilium.CefGlue.Headless.Service.ProxyUrl.TryParse(saved, out var legacy, out _))
        {
            var migrated = new PoolRow
            {
                Type = legacy.Scheme,
                Host = legacy.Host,
                Port = legacy.Port.ToString(),
                User = legacy.User ?? "",
                Password = legacy.Password ?? "",
            };
            _poolRows.Add(migrated);
            _poolGlobal = migrated;
        }

    }

