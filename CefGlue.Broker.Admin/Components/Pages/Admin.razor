    private string SessionTimingError
    {
        get
        {
            if (!int.TryParse(Norm(_selectedSessionTimeoutSeconds) ?? "300", out var timeout) || timeout < 1)
            {
                return "Session Timeout must be a whole number of seconds, 1 or more.";
            }

            if (!int.TryParse(Norm(_selectedManifestTtlSeconds) ?? "900", out var ttl) || ttl < 1)
            {
                return "Manifest TTL must be a whole number of seconds, 1 or more.";
            }

            return ttl < timeout
                ? $"Manifest TTL ({ttl}s) can't be shorter than Session Timeout ({timeout}s) - a timed-out session must stay restorable at least as long as it waited."
                : null;
        }
    }

