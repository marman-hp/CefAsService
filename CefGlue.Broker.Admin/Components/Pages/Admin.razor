    private void LookUpRecording()
    {
        _recordingLookup = null;
        _recordingLookupGenuine = null;
        _recordingLookupGenuineText = null;
        _confirmingRecordingDelete = false;
        var input = _recordingLookupInput?.Trim() ?? "";
        var isHash = input.Length == 64 && input.All(Uri.IsHexDigit);
        var id = isHash ? null : Xilium.CefGlue.Broker.Storage.RecordingLog.NormalizeId(input);
        if (!isHash && id == null)
        {
            _recordingLookupMessage = "Paste a recording ID (CASR-...) from the file's properties, or the file's SHA-256.";
            return;
        }
        try
        {
            var db = AdminDb.Db;
            var days = int.TryParse(_selectedRecordingLogDays, out var d) && d >= 1 && d <= 3650
                ? d : Xilium.CefGlue.Broker.Storage.RecordingLog.DefaultDays;
            Xilium.CefGlue.Broker.Storage.RecordingLog.Prune(db, days);
            _recordingLookup = isHash
                ? Xilium.CefGlue.Broker.Storage.RecordingLog.FindBySha256(db, input)
                : Xilium.CefGlue.Broker.Storage.RecordingLog.Find(db, id);
            _recordingLookupMessage = _recordingLookup == null
                ? $"{(isHash ? "This SHA-256" : id)}: not in the log (unknown, erased, older than the retention - or the file was changed)."
                : null;
        }
        catch (Exception ex)
        {
            _recordingLookupMessage = "Recording log unavailable: " + ex.Message;
        }

        var checkId = _recordingLookup?.Id ?? id;
        if (checkId != null)
        {
            var cefrec = CefRec();
            _recordingLookupGenuine = cefrec?.VerifyId(checkId);
            _recordingLookupGenuineText = _recordingLookupGenuine switch
            {
                true => "Genuine - this ID was made by CAS's recorder",
                false => "NOT genuine - this ID was not made by CAS's recorder (typed wrong, edited or forged)",
                null => "Can't check: " + (cefrec?.Error ?? "set the worker path in the Executables tab"),
            };
        }
    }

    private void DeleteRecordingLog()
    {
        if (_recordingLookup == null)
        {
            return;
        }
        var cefrec = CefRec();
        var result = cefrec?.Erase(AdminDb.Path, _recordingLookup.Id);
        _recordingLookupMessage = result switch
        {
            Xilium.CefGlue.Headless.Service.CefRecLibrary.Ok => $"{_recordingLookup.Id}: log entry erased (IP, page, title, tenant and server removed).",
            Xilium.CefGlue.Headless.Service.CefRecLibrary.BadHandle => $"{_recordingLookup.Id}: not in the log any more.",
            null => "Erase not possible: " + (cefrec?.Error ?? "set the worker path in the Executables tab"),
            _ => $"Erase failed (code {result}) - the recording log is unavailable.",
        };
        if (result == Xilium.CefGlue.Headless.Service.CefRecLibrary.Ok || result == Xilium.CefGlue.Headless.Service.CefRecLibrary.BadHandle)
        {
            _recordingLookup = null;
        }
        _confirmingRecordingDelete = false;
