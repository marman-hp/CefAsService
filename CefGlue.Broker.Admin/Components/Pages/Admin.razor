@page "/admin"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject BrokerSupervisor Supervisor
@inject RemoteWorkerSource WorkerSource
@inject AdminAuth Auth
@inject AdminSettingsStore AdminSettings
@inject ExePaths Paths
@inject NavigationManager Navigation

<PageTitle>CefGlue Broker - Admin</PageTitle>

<div class="admin-page">
    @if (_reloadPhase != null)
    {
        <div class="reload-guard" role="alertdialog" aria-modal="true" aria-busy="true" aria-labelledby="reload-title">
            <div class="reload-card">
                <div class="reload-spinner" aria-hidden="true"></div>
                <div class="reload-title" id="reload-title">Reloading…</div>
                <div class="reload-step" aria-live="polite">@_reloadPhase</div>
                <div class="reload-note">Settings are locked until the broker is back with them applied.</div>
            </div>
        </div>
    }
    @if (_confirmingRecording)
    {
        <div class="reload-guard" role="alertdialog" aria-modal="true" aria-labelledby="recording-confirm-title">
            <div class="reload-card recording-confirm">
                <div class="reload-title" id="recording-confirm-title">Enable session recording?</div>
                <div class="recording-warning-text">
                    @RecordingWarningBody
                </div>
                <label class="checkbox-option recording-confirm-check">
                    <input type="checkbox" checked="@_recordingRiskAccepted"
                           @onchange="@(e => _recordingRiskAccepted = (bool)e.Value)" />
                    I understand and accept responsibility
                </label>
                <div class="recording-confirm-actions">
                    <button class="btn" @onclick="CancelRecordingEnable">Cancel</button>
                    <button class="btn btn-danger" disabled="@(!_recordingRiskAccepted)" @onclick="AcceptRecordingEnable">Enable recording</button>
                </div>
            </div>
        </div>
    }
    <div class="page-header">
        <h1>CefGlue Broker Admin</h1>
        <form method="post" action="/logout">
            <AntiforgeryToken />
            <button class="btn" type="submit">Log out</button>
        </form>
    </div>

    @if (Auth.PendingLoginNotice is { } loginNotice)
    {
        <div class="warning-banner warning-banner-error" role="alert">
            <div>
                <strong>@loginNotice.Count failed sign-in attempt@(loginNotice.Count == 1 ? "" : "s") since you last signed in</strong>
                (the last one at @loginNotice.LastFailureUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")). If that was not you, change the Admin
                password on the Admin Password tab and check that this page is only reachable from this machine.
            </div>
            <button class="btn" @onclick="Auth.AcknowledgeLoginNotice">Dismiss</button>
        </div>
    }

    @if (_isolationSwitch is { } isolationSwitch && isolationSwitch.AtUtc != _dismissedIsolationSwitchAtUtc)
    {
        <div class="warning-banner @(isolationSwitch.WipeOk ? "" : "warning-banner-error")" role="alert">
            <div>
                <strong>Isolation mode changed: per @isolationSwitch.From → per @isolationSwitch.To</strong>
                (broker start at @isolationSwitch.AtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")).
                @if (isolationSwitch.WipeOk)
                {
                    <span>The worker cache for every tenant was deleted - logins, cookies and site data are gone. Open tabs come back on their last URL, signed out.</span>
                }
                else
                {
                    <span>The worker cache could NOT be fully deleted (files still in use). Stop every worker, then restart the broker to retry.</span>
                }
            </div>
            <button class="btn" @onclick="() => _dismissedIsolationSwitchAtUtc = isolationSwitch.AtUtc">Dismiss</button>
        </div>
    }

    @if (WebRtcMissingEncoder is { } missingEncoder)
    {
        <div class="warning-banner" role="alert">
            <div>
                <strong>WebRTC needs a video encoder.</strong>
                Viewers get no video until @missingEncoder.DisplayName is installed.
                <div class="banner-attribution">@missingEncoder.Download.Attribution</div>
                @if (!string.IsNullOrEmpty(_bannerMessage))
                {
                    <div class="banner-error">@_bannerMessage</div>
                }
            </div>
            <button class="btn" disabled="@_bannerBusy" @onclick="() => DownloadFromBannerAsync(missingEncoder)">
                @(_bannerBusy ? "Downloading..." : $"Download from {missingEncoder.Download.Provider}")
            </button>
        </div>
    }
    else if (_justInstalledEncoder != null)
    {
        <div class="info-banner" role="status">
            <div>
                <strong>@_justInstalledEncoder installed.</strong>
                @(Supervisor.IsRunning ? "Restart the broker to start using it." : "Press Start to use it.")
            </div>
            @if (Supervisor.IsRunning)
            {
                <button class="btn" disabled="@_restarting" @onclick="RestartAfterInstallAsync">@(_restarting ? "Restarting..." : "Restart now")</button>
            }
            else
            {
                <button class="btn" @onclick="() => _justInstalledEncoder = null">Dismiss</button>
            }
        </div>
    }

    <section class="panel">
        <h2>Broker Controls</h2>

        <div class="control-row">
            <span>Status: <strong>@StatusText</strong></span>
            <span>PID: <strong>@(Supervisor.IsRunning ? Supervisor.Pid.ToString() : "-")</strong></span>
            <span>Uptime: <strong>@UptimeText</strong></span>
        </div>

        <div class="settings-tabs" role="tablist">
            @for (var i = 0; i < SettingsTabNames.Length; i++)
            {
                var tab = i;
                <button type="button" role="tab" aria-selected="@(_settingsTab == tab ? "true" : "false")"
                        class="settings-tab @(_settingsTab == tab ? "active" : "")" @onclick="() => _settingsTab = tab">
                    @SettingsTabNames[tab]
                    @if (SettingsTabHasPending(tab))
                    {
                        <span class="settings-tab-dot" title="Changed - restart to apply"></span>
                    }
                </button>
            }
        </div>

        <div class="settings-tab-page" hidden="@(_settingsTab != 0)">
        <div class="encoder-settings">
            <div class="encoder-header">
                <div class="encoder-heading">
                    <div class="encoder-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M4 5h16v10H4z M2 19h20 M9 15v4 M15 15v4"
                                  fill="none" stroke="currentColor"
                                  stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </div>

                    <div>
                        <div class="encoder-title">CEF Settings</div>
                        <div class="encoder-subtitle">
                            <span>GPU rendering, cache limits - applies at Chromium/CEF startup</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="encoder-body" style="flex-direction: column; gap: 0;">
                <div class="encoder-audio-row" style="margin-top: 0; padding-top: 0; border-top: none;">
                    <label class="checkbox-option">
                        <input type="checkbox" checked="@_selectedDisableGpu"
                               @onchange="@(e => _selectedDisableGpu = (bool)e.Value)" />
                        Disable GPU
                    </label>
                </div>
                <div class="setting-hint">
                    When disabled, frames are rendered in software and the screen quality is lower. You can
                    enable the GPU, but it depends on your GPU hardware: if it fails, rendering falls back to software.
                </div>

                <div class="encoder-audio-row">
                    <label class="checkbox-option" title="@(_selectedDisableGpu ? "Shared-texture rendering needs the GPU Disable GPU would be turning off" : null)">
                        <input type="checkbox" checked="@_selectedTextureEnable" disabled="@_selectedDisableGpu"
                               @onchange="@(e => _selectedTextureEnable = (bool)e.Value)" />
                        Texture Enable
                    </label>
                </div>

                <div class="encoder-audio-row">
                    <label class="checkbox-option">
                        <input type="checkbox" checked="@_selectedDevToolsEnabled"
                               @onchange="@(e => _selectedDevToolsEnabled = (bool)e.Value)" />
                        Allow DevTools
                    </label>
                    <span>@(_selectedDevToolsEnabled ? "Desktop viewers get DevTools in the menu, per tab" : "Off - no DevTools, no debugging port")</span>
                </div>
                <div class="encoder-audio-row">
                    <label for="disk-cache-size-input">Disk Cache Size</label>
                    <input id="disk-cache-size-input" type="number" min="0" step="1"
                           value="@SelectedDiskCacheSizeMb"
                           @onchange="@(e => SelectedDiskCacheSizeMb = (string)e.Value)" />
                    <span>MB</span>
                </div>

                <div class="encoder-audio-row">
                    <label for="media-cache-size-input">Media Cache Size</label>
                    <input id="media-cache-size-input" type="number" min="0" step="1"
                           value="@SelectedMediaCacheSizeMb"
                           @onchange="@(e => SelectedMediaCacheSizeMb = (string)e.Value)" />
                    <span>MB</span>
                </div>

                <div class="encoder-audio-row">
                    <label for="default-url-input">Default URL address</label>
                    <input id="default-url-input" type="text" spellcheck="false" class="url-input"
                           placeholder="@DefaultUrlFallback"
                           value="@_selectedDefaultUrl"
                           @onchange="@(e => _selectedDefaultUrl = ((string)e.Value)?.Trim())" />
                </div>

                <div class="encoder-audio-row">
                    <label class="checkbox-option">
                        <input type="checkbox" checked="@_selectedNewPageUseLastUrl"
                               @onchange="@(e => _selectedNewPageUseLastUrl = (bool)e.Value)" />
                        Use last URL when adding a new page
                    </label>
                    <span>@(_selectedNewPageUseLastUrl ? "\"+\" opens the address bar's current URL" : "\"+\" always opens the Default URL")</span>
                </div>

                <div class="encoder-audio-row worker-cache-row">
                    <label>Worker Cache</label>
                    <span>@FormatBytes(_cacheSizeBytes) @(_cacheTenantCount > 0 ? $"across {_cacheTenantCount} tenant(s)" : "")</span>

                    @if (_confirmingClearCache)
                    {
                        <span>Clear it? Requires no workers currently running.</span>
                        <button class="btn btn-danger" @onclick="ClearCacheAsync" disabled="@_clearingCache">Yes, clear</button>
                        <button class="btn" @onclick="() => _confirmingClearCache = false" disabled="@_clearingCache">Cancel</button>
                    }
                    else
                    {
                        <button class="btn btn-danger" @onclick="() => _confirmingClearCache = true" disabled="@(_clearingCache || !HasAnyCacheToClear)">
                            @(_clearingCache ? "Clearing..." : "Clear Cache")
                        </button>
                    }

                    @if (_clearCacheError != null)
                    {
                        <span class="pending-note">@_clearCacheError</span>
                    }
                </div>

                <div class="encoder-audio-row">
                    <label class="checkbox-option">
                        <input type="checkbox" checked="@_clearEverything" @onchange="@(e => _clearEverything = (bool)e.Value)" />
                        Clear everything
                    </label>
                    <span>also wipes the stale standalone dev-run cache - @FormatBytes(_standaloneCacheSizeBytes)</span>
                </div>
            </div>
        </div>
        </div>

        <div class="settings-tab-page" hidden="@(_settingsTab != 1)">
        <div class="encoder-settings">
            <div class="encoder-header">
                <div class="encoder-heading">
                    <div class="encoder-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M4 7h16M4 12h16M4 17h16M8 4v6M16 9v6M8 14v6"
                                  fill="none" stroke="currentColor"
                                  stroke-width="1.7" stroke-linecap="round" />
                        </svg>
                    </div>

                    <div>
                        <div class="encoder-title">Encoder Settings</div>
                        <div class="encoder-subtitle">
                            <select id="encoder-select" @bind="_selectedEncoder">
                                @foreach (var option in VisibleEncoderOptions)
                                {
                                    <option value="@(option.Value ?? "")">@option.Label</option>
                                }
                            </select>
                            @if (ActiveEncoderLibraryInfo != null)
                            {
                                <span>@ActiveEncoderLibraryInfo</span>
                            }
                        </div>
                    </div>
                </div>

                @if (HasTunableEncoderSettings)
                {
                    <div class="encoder-header-actions">
                        <button type="button"
                                class="reset-button"
                                title="Reset all tunable settings to defaults"
                                @onclick="ResetActiveEncoderSettings">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M3 11a9 9 0 1 1 2.64 6.36L3 14.72M3 5v6h6"
                                      fill="none"
                                      stroke="currentColor"
                                      stroke-width="1.8"
                                      stroke-linecap="round"
                                      stroke-linejoin="round" />
                            </svg>
                            <span>Reset</span>
                        </button>

                        <span class="encoder-badge">
                            <span class="status-dot"></span>
                            Tunable
                        </span>
                    </div>
                }
            </div>

            @if (SelectedEncoderManifest is { Download: not null } downloadManifest)
            {
                <EncoderDownloadPanel Manifest="downloadManifest" OnChanged="StateHasChanged" />
            }

            <div class="encoder-body">
                @if (_encoderManifests.Count == 0)
                {
                    <div class="encoder-empty-state">No encoder plugins found next to the worker exe (plugins\encoders). Check the worker path in the Executables tab.</div>
                }
                else if (string.IsNullOrEmpty(_selectedEncoder))
                {
                    <div class="encoder-empty-state">Select an encoder above to configure it. Left unset, the broker falls back to plain JPG frames, which needs no native encoder at all.</div>
                }
                else if (SelectedEncoderManifest is not { } manifest)
                {
                    <div class="encoder-empty-state">This encoder isn't installed in the configured worker build (no matching plugin.json).</div>
                }
                else if (manifest.HasTunableSettings || manifest.Fixed.Count > 0)
                {
                    <EncoderSettingsForm Manifest="manifest" Values="_encoderValues" OnChanged="OnEncoderSettingsChanged" />
                }
                else
                {
                    <div class="encoder-empty-state">This encoder has no additional tunable settings yet - it runs with its own built-in defaults.</div>
                }
            </div>

            <div class="encoder-audio-row">
                <label for="audio-bitrate-input">Audio Bitrate (Opus)</label>
                <input id="audio-bitrate-input" type="number" min="6" max="510" step="1"
                       value="@_selectedAudioBitrateKbps"
                       @oninput="@(e => _selectedAudioBitrateKbps = (string)e.Value)" />
                <span>kbps</span>
            </div>
        </div>
        </div>

        <div class="settings-tab-page" hidden="@(_settingsTab != 2)">
        <div class="encoder-settings">
            <div class="encoder-header">
                <div class="encoder-heading">
                    <div class="encoder-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M4 7l4-4M4 7l4 4M4 7h16M20 17l-4 4M20 17l-4-4M20 17H4"
                                  fill="none" stroke="currentColor"
                                  stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </div>

                    <div>
                        <div class="encoder-title">Transport</div>
                        <div class="encoder-subtitle">
                            <span>@(TransportIsWebRtc ? "WebRTC" : "WebSocket")@(Supervisor.IsRunning ? "" : " - on next Start")</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="encoder-body" style="flex-direction: column;">
                <div class="encoder-empty-state" style="text-align: left;">
                    Fixed at broker launch via --use-webrtc - not changeable from Admin. Restart with a different flag to switch.
                </div>

                <div class="encoder-audio-row" style="margin-top: 0; padding-top: 0; border-top: none;">
                    <label>Connection Mode</label>
                    <div class="radio-group">
                        @foreach (var option in ConnectionModeOptions)
                        {
                            <label class="radio-option">
                                <input type="radio" name="mode-select" value="@option.Value"
                                       checked="@(_selectedMode == option.Value)"
                                       @onchange="() => _selectedMode = option.Value" />
                                @option.Label
                            </label>
                        }
                    </div>
                </div>

                @if (TransportIsWebRtc)
                {
                    <div class="encoder-audio-row">
                        <label for="webrtc-pacing-input">WebRTC Video Pacing</label>
                        <input id="webrtc-pacing-input" type="number" min="1000000" step="1000000"
                               value="@_selectedWebRtcPacingBps"
                               @oninput="@(e => _selectedWebRtcPacingBps = (string)e.Value)" />
                        <span>bps</span>
                        <button type="button" class="btn" @onclick="@(() => _selectedWebRtcPacingBps = "500000000")">Use 500M</button>
                    </div>

                    <div class="encoder-audio-row">
                        <label>WebRTC ICE Servers</label>
                        <select size="4" style="min-width:420px;" @bind="_selectedIceServerEntry">
                            @foreach (var uri in _iceServerEntries)
                            {
                                <option value="@uri">@uri</option>
                            }
                        </select>
                    </div>

                    <div class="encoder-audio-row">
                        <label for="ice-server-uri-input">STUN or TURN URI:</label>
                        <input id="ice-server-uri-input" type="text" style="min-width:280px;"
                               placeholder="stun:host:3478 or turn:host:3478?transport=udp"
                               @bind="_newIceServerUri" />
                    </div>

                    <div class="encoder-audio-row">
                        <label for="ice-server-username-input">TURN username:</label>
                        <input id="ice-server-username-input" type="text" @bind="_newIceServerUsername" />
                    </div>

                    <div class="encoder-audio-row">
                        <label for="ice-server-password-input">TURN password:</label>
                        <input id="ice-server-password-input" type="text" @bind="_newIceServerPassword" />
                    </div>

                    <div class="encoder-audio-row">
                        <button type="button" class="btn" @onclick="AddIceServer">Add Server</button>
                        <button type="button" class="btn btn-danger" @onclick="RemoveSelectedIceServer">Remove Server</button>
                        <button type="button" class="btn" @onclick="ResetIceServersToDefault">Reset to defaults</button>
                    </div>
                }

                <div class="encoder-audio-row">
                    <label class="checkbox-option">
                        <input id="require-tickets-input" type="checkbox" checked="@_selectedRequireTickets"
                               @onchange="@(e => _selectedRequireTickets = (bool)e.Value)" />
                        Require signed tickets
                    </label>
                </div>
                <div class="setting-hint">
                    What it protects: every worker opens its own port. Without signed tickets, anyone who can reach that port can
                    watch and control the session's browser, open its DevTools (cookies, logins) or download its recordings, without
                    going through the Broker. With them, the Broker checks the viewer first and then signs a short-lived ticket for
                    that one session and that one use; the worker refuses anything else. The secret behind the signature is new on
                    every Broker start.
                </div>
                <div class="setting-hint">
                    On: requests without a valid ticket are refused. Off: they are only logged as "allowed (log-only...)" - check that
                    log before switching it on. Switch it on when CAS is reachable by other people (LAN, VPS, tunnel). Applies on the
                    next Start/Restart. A CEFGLUE_REQUIRE_TICKET environment variable wins over this setting.
                </div>
            </div>
        </div>
        </div>

        <div class="settings-tab-page" hidden="@(_settingsTab != 3)">
        <div class="encoder-settings">
            <div class="encoder-header">
                <div class="encoder-heading">
                    <div class="encoder-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 8v4l3 3M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z"
                                  fill="none" stroke="currentColor"
                                  stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </div>

                    <div>
                        <div class="encoder-title">Session &amp; Cleanup</div>
                        <div class="encoder-subtitle">
                            <span>Worker lifecycle</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="encoder-body" style="flex-direction: column;">
                <div class="encoder-audio-row" style="margin-top: 0; padding-top: 0; border-top: none;">
                    <label for="session-timeout-input">Session Timeout</label>
                    <input id="session-timeout-input" type="number" min="1" step="1"
                           aria-invalid="@(SessionTimingError != null ? "true" : "false")"
                           value="@_selectedSessionTimeoutSeconds"
                           @oninput="@(e => _selectedSessionTimeoutSeconds = (string)e.Value)" />
                    <span>sec (how long a worker runs with no viewer before it stops - tabs and logins are kept, see Manifest TTL)</span>
                </div>

                <div class="encoder-audio-row">
                    <label for="manifest-ttl-input">Manifest TTL</label>
                    <input id="manifest-ttl-input" type="number" min="1" step="1"
                           aria-invalid="@(SessionTimingError != null ? "true" : "false")"
                           aria-describedby="session-timing-error"
                           value="@_selectedManifestTtlSeconds"
                           @oninput="@(e => _selectedManifestTtlSeconds = (string)e.Value)" />
                    <span>sec (how long a timed-out tenant's tabs and logins are kept before being deleted)</span>
                </div>
                @if (SessionTimingError is { } timingError)
                {
                    <div id="session-timing-error" class="error" role="alert">@timingError</div>
                }

                <div class="encoder-audio-row">
                    <label>Isolation Mode</label>
                    <strong>@IsolationModeLabel</strong>
                    <span>fixed at broker launch via --isolation-mode-session. Switching it wipes the worker cache (all logins) on the next broker start.</span>
                </div>
            </div>
        </div>
        </div>

        <div class="settings-tab-page" hidden="@(_settingsTab != 8)">
        <div class="encoder-settings">
            <div class="encoder-header">
                <div class="encoder-heading">
                    <div class="encoder-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M3 5h18l-7 8v6l-4 2v-8z"
                                  fill="none" stroke="currentColor"
                                  stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </div>

                    <div>
                        <div class="encoder-title">Browsing filter</div>
                        <div class="encoder-subtitle">
                            <span>What the remote browser may open. A refused address gets HTTP 403 "Blocked by the server administrator". Apply takes effect within seconds, no restart.</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="encoder-body" style="flex-direction: column;">
                <div class="encoder-audio-row" style="margin-top: 0; padding-top: 0; border-top: none;">
                    <label for="filter-mode-input">Filter</label>
                    <select id="filter-mode-input" @onchange="@(e => _selectedFilterMode = (string)e.Value)">
                        <option value="Internal" selected="@(_selectedFilterMode != "Off")">On (block internal addresses)</option>
                        <option value="Off" selected="@(_selectedFilterMode == "Off")">Off (the browser may open anything - not for public servers)</option>
                    </select>
                </div>
                @if (_selectedFilterMode == "Off")
                {
                    <div class="error" role="note">With the filter off, anyone who can open a tab can make this server's browser read its own local services (including this Admin page) and local files.</div>
                }

                <div class="encoder-audio-row">
                    <label for="filter-enforce-input">Enforcement</label>
                    <select id="filter-enforce-input" disabled="@(_selectedFilterMode == "Off")" @onchange="@(e => _selectedFilterEnforce = (string)e.Value)">
                        <option value="essential" selected="@(_selectedFilterEnforce == "essential")">Essential (CAS's own ports, local files, Deny list)</option>
                        <option value="full" selected="@(_selectedFilterEnforce == "full")">Full (also loopback, private, link-local and similar addresses)</option>
                        <option value="log" selected="@(_selectedFilterEnforce == "log")">Log only (nothing is refused - to look for false positives)</option>
                    </select>
                </div>

                <div class="encoder-audio-row">
                    <label class="checkbox-option">
                        <input type="checkbox" checked="@_selectedFilterBlockFile" disabled="@(_selectedFilterMode == "Off")"
                               @onchange="@(e => _selectedFilterBlockFile = (bool)e.Value)" />
                        Block local files (file:)
                    </label>
                </div>

                <div class="encoder-audio-row">
                    <label for="filter-allow-input">Allow</label>
                    <textarea id="filter-allow-input" rows="4" spellcheck="false" placeholder="one per line, e.g. intranet.example.com or 10.0.0.5:8080 or *.corp.test"
                              disabled="@(_selectedFilterMode == "Off")"
                              @oninput="@(e => _selectedFilterAllow = (string)e.Value)">@_selectedFilterAllow</textarea>
                    <span>exceptions to the internal-address rule. Never reopens CAS's own ports.</span>
                </div>

                <div class="encoder-audio-row">
                    <label for="filter-deny-input">Deny</label>
                    <textarea id="filter-deny-input" rows="4" spellcheck="false" placeholder="one per line - always refused"
                              disabled="@(_selectedFilterMode == "Off")"
                              @oninput="@(e => _selectedFilterDeny = (string)e.Value)">@_selectedFilterDeny</textarea>
                    <span>extra hosts to refuse, same syntax as Allow.</span>
                </div>

                <div class="encoder-audio-row">
                    <label for="devtools-profile-input">DevTools commands</label>
                    <select id="devtools-profile-input" value="@DevToolsProfileShown" @onchange="@(e => OnDevToolsProfileChanged((string)e.Value))">
                        <option value="restricted">Restricted (default; allow-list, the rest is refused)</option>
                        <option value="learn">Learn (nothing is refused; the methods used are logged)</option>
                        <option value="full">Full (nothing is checked)</option>
                    </select>
                    <span>what a viewer's DevTools may send to this server's browser. A change closes open DevTools connections.</span>
                </div>
                @if (_confirmFullDevTools)
                {
                    <div class="error" role="alert">
                        Switch to Full? DevTools can then bypass the browsing filter above (open tabs the filter never sees, fetch internal addresses) and attach local files of this server to a page. Only do this on a server nobody else can reach.
                        <div class="encoder-audio-row">
                            <button class="btn" @onclick="ConfirmFullDevTools">Yes, use Full</button>
                            <button class="btn" @onclick="CancelFullDevTools">Cancel</button>
                        </div>
                    </div>
                }
                else if (DevToolsProfileNormalized == "full")
                {
                    <div class="error" role="note">Full: DevTools can bypass the filter above and read local files. Restricted is the recommended setting.</div>
                }
                else if (DevToolsProfileNormalized == "restricted")
                {
                    <div class="error" role="note">Restricted: built from real DevTools use. A DevTools feature whose command is not on the list is refused; the Broker log (and devtools-learn.log in Learn) names it.</div>
                }

                <div class="encoder-audio-row">
                    <button class="btn" @onclick="ApplyLiveSettingsAsync">Apply now</button>
                    @if (_liveApplyMessage != null)
                    {
                        <span class="@(_liveApplyError ? "error" : null)" role="status">@_liveApplyMessage</span>
                    }
                </div>
            </div>
        </div>
        </div>

        <div class="settings-tab-page" hidden="@(_settingsTab != 7)">
        <div class="encoder-settings">
            <div class="encoder-header">
                <div class="encoder-heading">
                    <div class="encoder-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M4 20V10 M10 20V4 M16 20v-7 M22 20H2"
                                  fill="none" stroke="currentColor"
                                  stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </div>

                    <div>
                        <div class="encoder-title">Limits</div>
                        <div class="encoder-subtitle">
                            <span>How many workers this server may run - 0 means unlimited. The administrator is responsible for the server's resources.</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="encoder-body" style="flex-direction: column;">
                <div class="encoder-audio-row" style="margin-top: 0; padding-top: 0; border-top: none;">
                    <label>This server</label>
                    <span>
                        <strong>@Environment.ProcessorCount</strong> logical processors (threads) &middot;
                        <strong>@FormatBytes(TotalMemoryBytes)</strong> RAM
                    </span>
                </div>
                <div class="encoder-audio-row">
                    <label>Right now</label>
                    <span>
                        <strong>@_workers.Count(w => w.Status != "Sleeping")</strong> workers running &middot;
                        <strong>@_workers.Count(w => w.Status == "Sleeping")</strong> sleeping &middot;
                        CAS processes use <strong>@FormatBytes(_casWorkingSetBytes)</strong>
                        @if (_workers.Count(w => w.Status != "Sleeping") is > 0 and var running)
                        {
                            <text>(about <strong>@FormatBytes(_casWorkingSetBytes / running)</strong> per running worker, all its tabs included)</text>
                        }
                    </span>
                </div>
                <div class="encoder-audio-row">
                    <label>Rule of thumb</label>
                    <span>
                        Software video encoding (VP9, OpenH264, x264) takes roughly 1 to 3 threads per <em>active</em> stream - with
                        @Environment.ProcessorCount threads that is about @(Math.Max(1, Environment.ProcessorCount / 3)) to @Environment.ProcessorCount workers streaming at once.
                        Idle tabs cost RAM, not CPU, so also watch the memory figure above.
                    </span>
                </div>

                @foreach (var field in LimitFields)
                {
                    <div class="encoder-audio-row">
                        <label for="limit-@field.Key">@field.Label</label>
                        <input id="limit-@field.Key" type="number" min="0" step="1"
                               value="@_selectedLimits.GetValueOrDefault(field.Key)"
                               @oninput="@(e => _selectedLimits[field.Key] = (string)e.Value)" />
                        <span>@field.Help (default @LimitDefault(field.Key))</span>
                    </div>
                }
                @if (LimitsPending)
                {
                    <div class="error" role="note">Changed - restart the Broker to apply.</div>
                }
            </div>
        </div>
        </div>

        <div class="settings-tab-page" hidden="@(_settingsTab != 6)">
        <div class="encoder-settings">
            <div class="encoder-header">
                <div class="encoder-heading">
                    <div class="encoder-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"
                                  fill="none" stroke="currentColor"
                                  stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </div>

                    <div>
                        <div class="encoder-title">Recording</div>
                        <div class="encoder-subtitle">
                            <span>Viewer session recording (MP4 video, MP3 audio) - Apply now takes effect in running workers within seconds</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="encoder-body" style="flex-direction: column;">
                <div class="warning-banner recording-warning" role="note">
                    <div>
                        <strong>&#9888; Session recording</strong>
                        <div>@RecordingWarningBody</div>
                        @if (_selectedRecordingEnabled && !string.IsNullOrEmpty(_recordingWarningAcceptedAt)
                             && DateTimeOffset.TryParse(_recordingWarningAcceptedAt, out var acceptedAt))
                        {
                            <div class="recording-accepted">Accepted by the administrator on @acceptedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm").</div>
                        }
                    </div>
                </div>
                <div class="encoder-audio-row" style="margin-top: 0; padding-top: 0; border-top: none;">
                    <label class="checkbox-option">
                        <input type="checkbox" checked="@(_selectedRecordingEnabled || _confirmingRecording)"
                               @onchange="@(e => OnRecordingToggled((bool)e.Value))" />
                        Enable recording
                    </label>
                    <span>@(_selectedRecordingEnabled ? "Viewers get Record in the menu" : "Off - viewers see no recording")</span>
                </div>

                <div class="encoder-audio-row">
                    <label for="recording-max-concurrent-input">Max recordings</label>
                    <input id="recording-max-concurrent-input" type="number" min="1" max="16" step="1"
                           disabled="@(!_selectedRecordingEnabled)"
                           value="@_selectedRecordingMaxConcurrent"
                           @oninput="@(e => _selectedRecordingMaxConcurrent = (string)e.Value)" />
                    <span>video recordings at the same time, per worker (default 2)</span>
                </div>

                <div class="encoder-audio-row">
                    <label for="recording-max-minutes-input">Max duration</label>
                    <input id="recording-max-minutes-input" type="number" min="1" max="1440" step="1"
                           disabled="@(!_selectedRecordingEnabled)"
                           value="@_selectedRecordingMaxMinutes"
                           @oninput="@(e => _selectedRecordingMaxMinutes = (string)e.Value)" />
                    <span>minutes per video recording - it stops and downloads itself at the limit (default 30)</span>
                </div>

                <div class="encoder-audio-row">
                    <label>Audio only (MP3)</label>
                    <span>not limited - no duration cap, not counted in Max recordings</span>
                </div>

                <div class="encoder-audio-row">
                    <label for="recording-log-days-input">Keep recording log</label>
                    <input id="recording-log-days-input" type="number" min="1" max="3650" step="1"
                           value="@_selectedRecordingLogDays"
                           @oninput="@(e => _selectedRecordingLogDays = (string)e.Value)" />
                    <span>days - who recorded what (IP, time, page) behind each recording ID; older rows are deleted (default 90)</span>
                </div>

                <div class="encoder-audio-row">
                    <button class="btn" @onclick="ApplyLiveSettingsAsync">Apply now</button>
                    @if (_liveApplyMessage != null)
                    {
                        <span class="@(_liveApplyError ? "error" : null)" role="status">@_liveApplyMessage</span>
                    }
                    <span>no restart needed; turning recording off stops running recordings and offers them for download</span>
                </div>

                <div class="encoder-audio-row recording-lookup-row">
                    <label for="recording-lookup-input">Look up a recording</label>
                    <input id="recording-lookup-input" type="text" placeholder="CASR-... or the file's SHA-256" autocomplete="off" spellcheck="false"
                           value="@_recordingLookupInput"
                           @oninput="@(e => _recordingLookupInput = (string)e.Value)"
                           @onkeydown="@(e => { if (e.Key == "Enter") LookUpRecording(); })" />
                    <button class="btn" @onclick="LookUpRecording">Look up</button>
                </div>
                @if (_recordingLookupMessage != null)
                {
                    <div class="recording-lookup-message">@_recordingLookupMessage</div>
                }
                @if (_recordingLookupGenuineText != null)
                {
                    <div class="recording-lookup-message @(_recordingLookupGenuine == false ? "error" : null)">@_recordingLookupGenuineText</div>
                }
                @if (_recordingLookup is { } rec)
                {
                    <table class="recording-lookup-table">
                        <tr><th>Recording ID</th><td>@rec.Id</td></tr>
                        <tr><th>Status</th><td>@rec.Status (@rec.Kind)</td></tr>
                        <tr><th>Started (UTC)</th><td>@rec.StartedUtc</td></tr>
                        <tr><th>Ended (UTC)</th><td>@(rec.EndedUtc ?? "-")</td></tr>
                        <tr><th>Size</th><td>@(rec.Bytes is long b ? $"{b / 1024.0 / 1024.0:0.0} MB" : "-")</td></tr>
                        <tr><th>File SHA-256</th><td class="recording-lookup-url">@(rec.Sha256 ?? "-")</td></tr>
                        <tr><th>Viewer IP</th><td>@(rec.ViewerIp ?? "-")</td></tr>
                        <tr><th>Page</th><td class="recording-lookup-url">@(rec.Url ?? "-")</td></tr>
                        <tr><th>Title</th><td>@(rec.Title ?? "-")</td></tr>
                        <tr><th>Tenant</th><td>@(rec.Tenant ?? "-")</td></tr>
                        <tr><th>Server</th><td>@(rec.Server ?? "-")</td></tr>
                        <tr><th>Consent version</th><td>@rec.ConsentVersion</td></tr>
                    </table>
                    @if (rec.Status != "erased")
                    {
                        <div class="recording-lookup-actions">
                            @if (_confirmingRecordingDelete)
                            {
                                <span>Erase this log entry? IP, page, title, tenant and server are removed; the ID stays genuine but can't be traced to a person afterwards.</span>
                                <button class="btn" @onclick="() => _confirmingRecordingDelete = false">Cancel</button>
                                <button class="btn btn-danger" @onclick="DeleteRecordingLog">Erase</button>
                            }
                            else
                            {
                                <button class="btn btn-danger" @onclick="() => _confirmingRecordingDelete = true">Erase log entry</button>
                            }
                        </div>
                    }
                }

                <div class="encoder-audio-row recording-lookup-row">
                    <label>Log integrity</label>
                    <button class="btn" @onclick="CheckRecordingLog">Check recording log</button>
                    <span>detects rows deleted or edited outside CAS</span>
                </div>
                @if (_recordingLogCheckMessage != null)
                {
                    <div class="recording-lookup-message @(_recordingLogProblems != null ? "error" : null)">@_recordingLogCheckMessage</div>
                }
                @if (_recordingLogProblems is { Count: > 0 } logProblems)
                {
                    <ul class="recording-lookup-message error">
                        @foreach (var problem in logProblems)
                        {
                            <li>@problem</li>
                        }
                    </ul>
                }
            </div>
        </div>
        </div>

        <div class="settings-tab-page" hidden="@(_settingsTab != 4)">
        <div class="encoder-settings">
            <div class="encoder-header">
                <div class="encoder-heading">
                    <div class="encoder-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M3 5h18v14H3z M3 9h18 M7 13l2 2-2 2 M12 17h4"
                                  fill="none" stroke="currentColor"
                                  stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </div>

                    <div>
                        <div class="encoder-title">Executables</div>
                        <div class="encoder-subtitle">
                            <span>Broker and worker exe paths - applies on the next Start/Restart</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="encoder-body" style="flex-direction: column;">
                <div class="path-form">
                    <label>Broker exe (@ExePaths.BrokerExeName)
                        <input type="text" spellcheck="false" @bind="_brokerPathInput"
                               placeholder="@PathPlaceholder("CEFGLUE_BROKER_EXE_PATH")" />
                        <span class="path-status">@(Supervisor.IsRunning ? $"Running: {Supervisor.RunningExePath ?? "unknown (attached)"}" : $"Next Start uses: {PathSourceText(Paths.BrokerExePath, "CEFGLUE_BROKER_EXE_PATH")}")</span>
                    </label>
                    <label>Worker exe (@ExePaths.WorkerExeName)
                        <input type="text" spellcheck="false" @bind="_workerPathInput"
                               placeholder="@PathPlaceholder("CEFGLUE_WORKER_EXE_PATH")" />
                        <span class="path-status">@(Supervisor.IsRunning ? $"In use by Broker: {_activeWorkerExePath ?? "unknown"}" : $"Next Start uses: {PathSourceText(Paths.WorkerExePath, "CEFGLUE_WORKER_EXE_PATH")}")</span>
                    </label>
                </div>
                <div class="control-row">
                    <button class="btn" @onclick="SavePaths">Save paths</button>
                    @if (_pathError != null)
                    {
                        <span class="error">@_pathError</span>
                    }
                    else if (_pathMessage != null)
                    {
                        <span class="pending-note">@_pathMessage</span>
                    }
                </div>
                @if (PathsNeedRestart)
                {
                    <div class="control-row">
                        <span class="pending-note">Saved paths differ from the running ones - restart the broker to use them.</span>
                    </div>
                }
            </div>
        </div>
        </div>

        <div class="settings-tab-page" hidden="@(_settingsTab != 9)">
        <div class="encoder-settings">
            <div class="encoder-header">
                <div class="encoder-heading">
                    <div class="encoder-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M4 12h16M13 6l7 6-7 6M4 6v12"
                                  fill="none" stroke="currentColor"
                                  stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </div>

                    <div>
                        <div class="encoder-title">Proxy</div>
                        <div class="encoder-subtitle">
                            <span>The address each session's browser goes out from. Saved with Start/Restart; used by every session started afterwards (a running session keeps its proxy until it is ended with Kill or times out). If a proxy is down or refuses the login, pages fail - there is never a fall back to a direct connection.</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="encoder-body" style="flex-direction: column;">
                <div class="encoder-audio-row" style="margin-top: 0; padding-top: 0; border-top: none;">
                    <label class="checkbox-option">
                        <input id="proxy-enabled-input" type="checkbox" checked="@_selectedProxyEnabled" @onchange="@(e => _selectedProxyEnabled = (bool)e.Value)" />
                        Use a proxy
                    </label>
                    <span>@(_selectedProxyEnabled ? "On: sessions started after the next Start/Restart go out through the proxy set here." : "Off: every session connects directly from this server. Anything filled in before is kept, hidden and not used.")</span>
                </div>
                @if (_selectedProxyEnabled)
                {
                <div class="encoder-audio-row">
                    <label for="proxy-mode-input">Mode</label>
                    <select id="proxy-mode-input" value="@_selectedProxyMode" @onchange="@(e => OnProxyModeChanged((string)e.Value))">
                        <option value="global">Global - one proxy from the table for every session</option>
                        <option value="pool">Manual - each session's user picks one from the table</option>
                    </select>
                    <span>@(_selectedProxyMode == "pool" ? "A new session asks its user to pick a proxy from the table; the pick is kept until the session ends." : "You choose one proxy of the table below; every session uses it.")</span>
                </div>
                @if (_selectedProxyMode != "pool")
                {
                    <div class="encoder-audio-row">
                        <label for="proxy-global-input">Global proxy</label>
                        <select id="proxy-global-input" value="@GlobalIndex" @onchange="@(e => OnGlobalChosen((string)e.Value))">
                            <option value="-1">(choose one from the table)</option>
                            @for (var g = 0; g < _poolRows.Count; g++)
                            {
                                <option value="@g">@(string.IsNullOrWhiteSpace(_poolRows[g].Label) ? $"Proxy {g + 1}" : _poolRows[g].Label) - @_poolRows[g].Type.ToUpperInvariant() @_poolRows[g].Host:@_poolRows[g].Port</option>
                            }
                        </select>
                        <span>Every session's browser goes out through this proxy.</span>
                    </div>
                    @if (_poolRows.Count == 0)
                    {
                        <div class="error" role="note">The table has no proxy yet: add one below, then choose it here.</div>
                    }
                    else if (_poolGlobal == null)
                    {
                        <div class="error" role="note">Choose the global proxy from the table (the settings cannot be saved without it).</div>
                    }
                }
                    <div style="display: flex; flex-direction: column; gap: 8px; width: 100%; margin-top: 12px; padding-top: 12px; border-top: 1px solid rgba(255, 255, 255, 0.08);">
                        <div style="font-weight: 600; text-transform: uppercase; font-size: 0.8em; letter-spacing: 0.04em;">Proxies (@_poolRows.Count)</div>

                        <div class="table-scroll" style="min-height: 150px; max-height: 320px; overflow-y: auto; border: 1px solid rgba(255, 255, 255, 0.10); border-radius: 6px;">
                            <table aria-label="Proxies in the pool" style="width: 100%; min-width: 560px;">
                                <thead>
                                    <tr><th style="width: 48px;">#</th><th style="width: 90px;">Type</th><th>Address</th><th style="width: 160px;">Login</th><th style="width: 200px;">Label</th>@if (_selectedProxyMode != "pool") {<th style="width: 90px;">Global</th>}</tr>
                                </thead>
                                <tbody>
                                    @for (var i = 0; i < _poolRows.Count; i++)
                                    {
                                        var r = _poolRows[i];
                                        var number = i + 1;
                                        <tr class="pool-row" aria-selected="@(ReferenceEquals(r, _poolSelected) ? "true" : "false")" style="cursor: pointer; @(ReferenceEquals(r, _poolSelected) ? "background: rgba(224, 151, 90, 0.20);" : "")"
                                            @onclick="() => SelectPoolRow(r)">
                                            <td class="mono">@number</td>
                                            <td>@r.Type.ToUpperInvariant()</td>
                                            <td class="mono">@r.Host:@r.Port</td>
                                            <td>@(string.IsNullOrEmpty(r.User) ? "-" : r.User)</td>
                                            <td>@(string.IsNullOrWhiteSpace(r.Label) ? $"Proxy {number}" : r.Label)</td>
                                            @if (_selectedProxyMode != "pool")
                                            {
                                                <td>@(ReferenceEquals(r, _poolGlobal) ? "Global" : "")</td>
                                            }
                                        </tr>
                                    }
                                    @if (_poolRows.Count == 0)
                                    {
                                        <tr><td colspan="@(_selectedProxyMode != "pool" ? 6 : 5)" class="empty">No proxy in the table yet. Fill in the form below and press Add.</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (_selectedProxyEnabled && _selectedProxyMode == "pool" && _poolRows.Count == 0)
                        {
                            <div class="error" role="note">Manual mode needs at least one proxy in the table before the settings can be saved (or switch the proxy off).</div>
                        }
                        @if (PoolListError() is { } poolError)
                        {
                            <div class="error" role="note">@poolError</div>
                        }

                        <div style="font-size: 0.85em; opacity: 0.8;">@(_poolSelected == null ? "Add a proxy" : "Edit the selected proxy")</div>
                        <div style="display: flex; gap: 6px; flex-wrap: wrap; align-items: center;">
                            <select aria-label="Proxy type" style="width: 105px;" value="@_poolDraft.Type" @onchange="@(e => _poolDraft.Type = (string)e.Value)">
                                <option value="http">HTTP</option>
                                <option value="https">HTTPS</option>
                                <option value="socks5">SOCKS5</option>
                            </select>
                            <input type="text" aria-label="Proxy host" placeholder="host" spellcheck="false" style="flex: 1 1 200px; min-width: 150px;"
                                   value="@_poolDraft.Host" @oninput="@(e => _poolDraft.Host = (string)e.Value)" />
                            <input type="number" aria-label="Proxy port" placeholder="port" min="1" max="65535" style="width: 90px;"
                                   value="@_poolDraft.Port" @oninput="@(e => _poolDraft.Port = (string)e.Value)" />
                            <input type="text" aria-label="Proxy user name" placeholder="user (optional)" autocomplete="off" spellcheck="false" style="flex: 0 1 150px; min-width: 110px;"
                                   disabled="@(_poolDraft.Type == "socks5")" value="@_poolDraft.User" @oninput="@(e => _poolDraft.User = (string)e.Value)" />
                            <input type="password" aria-label="Proxy password" placeholder="password" autocomplete="new-password" style="flex: 0 1 150px; min-width: 110px;"
                                   disabled="@(_poolDraft.Type == "socks5")" value="@_poolDraft.Password" @oninput="@(e => _poolDraft.Password = (string)e.Value)" />
                            <input type="text" aria-label="Label shown to the user" placeholder="label" spellcheck="false" style="flex: 0 1 170px; min-width: 110px;"
                                   value="@_poolDraft.Label" @oninput="@(e => _poolDraft.Label = (string)e.Value)" />
                        </div>
                        <div style="display: flex; gap: 6px; flex-wrap: wrap; align-items: center;">
                            @if (_poolSelected == null)
                            {
                                <button type="button" class="btn" @onclick="AddOrUpdatePoolRow">Add</button>
                            }
                            else
                            {
                                <button type="button" class="btn" @onclick="AddOrUpdatePoolRow">Update</button>
                                <button type="button" class="btn btn-danger" @onclick="DeletePoolRow">Delete</button>
                                <button type="button" class="btn" @onclick="CancelPoolEdit">Cancel</button>
                            }
                            <button type="button" class="btn" @onclick="() => _showPoolImport = !_showPoolImport">@(_showPoolImport ? "Close" : "Add many...")</button>
                        </div>
                        @if (_poolFormError != null)
                        {
                            <div class="error" role="note">@_poolFormError</div>
                        }
                        @if (_showPoolImport)
                        {
                            <div style="display: flex; flex-direction: column; gap: 6px;">
                                <span>"Add many" takes one proxy per line as <span class="mono">host:port</span>, <span class="mono">user:password@host:port</span> or a full <span class="mono">http://...</span> address, each optionally followed by <span class="mono"># label</span>; lines without a scheme get the type chosen here.</span>
                                <div style="display: flex; gap: 6px; align-items: center; flex-wrap: wrap;">
                                    <span>Type of the lines without a scheme:</span>
                                    <select aria-label="Type for imported lines" style="width: 105px;" value="@_poolImportType" @onchange="@(e => _poolImportType = (string)e.Value)">
                                        <option value="http">HTTP</option>
                                        <option value="https">HTTPS</option>
                                        <option value="socks5">SOCKS5</option>
                                    </select>
                                </div>
                                <textarea rows="6" spellcheck="false" autocomplete="off" aria-label="Proxies to add, one per line"
                                          placeholder="one per line: 203.0.113.5:8080 # label"
                                          @oninput="@(e => _poolImportText = (string)e.Value)">@_poolImportText</textarea>
                                <div style="display: flex; gap: 6px;">
                                    <button type="button" class="btn" @onclick="ImportPoolLines">Add these</button>
                                </div>
                                @if (_poolImportError != null)
                                {
                                    <div class="error" role="note">@_poolImportError</div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
        </div>

        <div class="settings-tab-page" hidden="@(_settingsTab != 5)">
        <div class="encoder-settings">
            <div class="encoder-header">
                <div class="encoder-heading">
                    <div class="encoder-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M6 11h12v9H6z M8.5 11V8a3.5 3.5 0 0 1 7 0v3"
                                  fill="none" stroke="currentColor"
                                  stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </div>

                    <div>
                        <div class="encoder-title">Admin Password</div>
                        <div class="encoder-subtitle">
                            <span>Changing it signs out every Admin session, this one included</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="encoder-body admin-password-body" style="flex-direction: column;">
                <div class="password-form">
                    <label>Current password
                        <input type="password" autocomplete="current-password" @bind="_currentPassword" />
                    </label>
                    <label>New password
                        <input type="password" autocomplete="new-password" @bind="_newPassword" />
                    </label>
                    <label>Confirm new password
                        <input type="password" autocomplete="new-password" @bind="_confirmPassword" />
                    </label>
                </div>
