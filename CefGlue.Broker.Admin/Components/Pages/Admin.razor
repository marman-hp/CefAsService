    private Task ApplyLiveSettingsAsync()
    {
        var fields = new Dictionary<string, string>
        {
            ["FilterMode"] = _selectedFilterMode ?? "Internal",
            ["FilterEnforce"] = _selectedFilterEnforce ?? "essential",
            ["FilterAllowHosts"] = _selectedFilterAllow?.Trim() ?? "",
            ["FilterDenyHosts"] = _selectedFilterDeny?.Trim() ?? "",
            ["FilterBlockFileScheme"] = _selectedFilterBlockFile ? "" : "0",
            ["DevToolsProfile"] = DevToolsProfileNormalized,
            ["RecordingEnabled"] = _selectedRecordingEnabled ? "1" : "0",
        };
        void Optional(string key, string value)
        {
            if (value != null)
            {
                fields[key] = value.Trim();
            }
        }

        Optional("RecordingMaxConcurrent", _selectedRecordingMaxConcurrent);
        Optional("RecordingMaxMinutes", _selectedRecordingMaxMinutes);
        Optional("RecordingLogDays", _selectedRecordingLogDays);
        Optional("RecordingWarningAcceptedAt", _recordingWarningAcceptedAt);

        try
        {
            BrokerSettingsWriter.Save(AdminDb.Db, fields, null);
            var saved = Xilium.CefGlue.Broker.Storage.BrokerDb.ReadJson(AdminDb.Db, Xilium.CefGlue.Broker.Storage.BrokerDb.Settings);
            var revision = Xilium.CefGlue.Broker.Storage.BrokerDb.AsString(saved.GetValueOrDefault(BrokerSettingsWriter.SettingsRevisionKey));
            _liveApplyError = false;
            _liveApplyMessage = $"Applied (revision {revision}) at {DateTime.Now:HH:mm:ss} - running workers pick it up within a few seconds.";
        }
        catch (Exception ex)
        {
            _liveApplyError = true;
            _liveApplyMessage = $"Not applied: {ex.Message}";
            Console.WriteLine($"[Admin] Apply failed: {ex.Message}");
        }

        return Task.CompletedTask;
    }

