<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(DotnetVersion)</TargetFramework>
    <AssemblyName>Xilium.CefGlue.Broker.Admin</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Xilium.CefGlue.Broker.Admin</RootNamespace>
    <Nullable>disable</Nullable>
    <Product>Xilium.CefGlue.Broker.Admin</Product>
    <AssemblyTitle>Xilium.CefGlue.Broker.Admin</AssemblyTitle>
    <Authors>Marman-HP</Authors>
    <Copyright>Copyright © 2026 Marman-HP. Portions Copyright © XiliumHQ 2021, OutSystems 2021.</Copyright>
  </PropertyGroup>

  <Target Name="BuildSiblingProcesses" AfterTargets="Build" Condition="'$(BuildingSolutionFile)' != 'true'">
    <Exec Command="dotnet build &quot;$(MSBuildThisFileDirectory)..\CefGlue.Broker\CefGlue.Broker.csproj&quot; -c $(Configuration) -p:Platform=$(Platform)" />
    <Exec Command="dotnet build &quot;$(MSBuildThisFileDirectory)..\CefGlue.Headless.Service\CefGlue.Headless.Service.csproj&quot; -c $(Configuration) -p:Platform=$(Platform)" />
  </Target>

  <ItemGroup>
    <None Include="$(NuGetPackageRoot)\microsoft.aspnetcore.app.internal.assets\**\_framework\blazor.web.js">
      <Link>wwwroot\_framework\blazor.web.js</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(IntermediateOutputPath)scopedcss\bundle\$(AssemblyName).styles.css">
      <Link>wwwroot\$(AssemblyName).styles.css</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\CefGlue.Headless.Service\ErrorLog.cs" Link="ErrorLog.cs" />
    <Compile Include="..\CefGlue.Headless.Service\TenantCachePaths.cs" Link="TenantCachePaths.cs" />
    <Compile Include="..\CefGlue.Broker\Storage\Sqlite3Native.cs" Link="Storage\Sqlite3Native.cs" />
    <Compile Include="..\CefGlue.Broker\Storage\SqliteDb.cs" Link="Storage\SqliteDb.cs" />
    <Compile Include="..\CefGlue.Broker\Storage\BrokerDb.cs" Link="Storage\BrokerDb.cs" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <None Include="..\CefGlue.Broker\native\win-x64\sqlite3.dll" Link="sqlite3.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
